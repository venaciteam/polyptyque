// Fenêtres modales : ajout de sources, scènes, réglages, confirmations.

import { ComboBox, LineEdit, CheckBox, ListView, ScrollView, SpinBox, Spinner } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Bridge, ScheduleItem } from "bridge.slint";
import { ActionButton, Field, Footer, IconButton, LevelMeter, Note, Sheet, ListRow, Toggle } from "components.slint";

export component AddBrowserSheet inherits Sheet {
    title: @tr("Ajouter une source navigateur");
    close => {
        Bridge.close-sheet();
    }

    Field {
        label: @tr("Navigateur");
        ComboBox {
            model: Bridge.browser-choices;
            current-index <=> Bridge.browser-index;
        }
    }
    if Bridge.browser-index == Bridge.browser-choices.length - 1: Field {
        label: @tr("Fichier .exe du navigateur");
        LineEdit {
            text <=> Bridge.browser-path;
            placeholder-text: @tr("C:\\Program Files\\…\\navigateur.exe");
        }
    }
    Field {
        label: @tr("Nom de la source");
        hint: @tr("Utilisé dans le nom du fichier enregistré.");
        LineEdit {
            text <=> Bridge.new-name;
        }
    }
    Field {
        label: @tr("Adresse au premier lancement (facultatif)");
        LineEdit {
            text <=> Bridge.new-url;
            placeholder-text: "https://…";
        }
    }
    CheckBox {
        text: @tr("Ouvrir maintenant pour se connecter et préparer les onglets");
        checked <=> Bridge.open-now;
    }
    Note {
        text: @tr("Cette source a son propre profil : connexions et onglets sont conservés. Tout son joué dans ce profil, quel que soit l'onglet, sera enregistré dans son fichier.");
    }
    Footer {
        ActionButton {
            text: @tr("Annuler");
            kind: "ghost";
            clicked => {
                Bridge.close-sheet();
            }
        }
        ActionButton {
            text: @tr("Ajouter");
            kind: "primary";
            enabled: Bridge.new-name != "";
            clicked => {
                Bridge.confirm-add-browser();
            }
        }
    }
}

export component AddApplicationSheet inherits Sheet {
    title: @tr("Ajouter une source application");
    sheet-width: 600px;
    close => {
        Bridge.close-sheet();
    }

    Field {
        label: @tr("Fenêtre à enregistrer");
        Rectangle {
            height: 230px;
            background: Theme.surface-raised;
            border-radius: Theme.radius-small;
            border-width: 1px;
            border-color: Theme.border;
            ListView {
                for window[index] in Bridge.windows: ListRow {
                    text: window.title;
                    detail: window.program;
                    selected: index == Bridge.window-index;
                    clicked => {
                        Bridge.window-index = index;
                        Bridge.window-selected(index);
                    }
                }
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        ActionButton {
            text: @tr("Actualiser la liste");
            icon: @image-url("icons/refresh.svg");
            has-icon: true;
            kind: "ghost";
            clicked => {
                Bridge.refresh-windows();
            }
        }
    }
    if Bridge.window-index >= 0 && Bridge.window-index < Bridge.windows.length && Bridge.windows[Bridge.window-index].browser: Note {
        tone: 2;
        text: @tr("C'est un navigateur : son son sera mélangé avec celui de toutes ses autres fenêtres. Pour isoler le son, mieux vaut ajouter une source navigateur.");
    }
    Field {
        label: @tr("Nom de la source");
        hint: @tr("Utilisé dans le nom du fichier enregistré.");
        LineEdit {
            text <=> Bridge.new-name;
        }
    }
    CheckBox {
        text: @tr("Relancer ce programme s'il n'est pas ouvert au démarrage d'un enregistrement");
        checked <=> Bridge.relaunch;
    }
    CheckBox {
        text: @tr("Afficher le curseur de la souris dans l'enregistrement");
        checked <=> Bridge.capture-cursor;
    }
    Footer {
        ActionButton {
            text: @tr("Annuler");
            kind: "ghost";
            clicked => {
                Bridge.close-sheet();
            }
        }
        ActionButton {
            text: @tr("Ajouter");
            kind: "primary";
            enabled: Bridge.window-index >= 0 && Bridge.new-name != "";
            clicked => {
                Bridge.confirm-add-application();
            }
        }
    }
}

export component SceneNameSheet inherits Sheet {
    title: Bridge.sheet == "scene-new" ? @tr("Nouvelle scène") : Bridge.sheet == "scene-duplicate" ? @tr("Dupliquer la scène") : @tr("Renommer la scène");
    sheet-width: 440px;
    close => {
        Bridge.close-sheet();
    }
    init => {
        name-edit.focus();
    }

    Field {
        label: @tr("Nom de la scène");
        name-edit := LineEdit {
            text <=> Bridge.scene-name-input;
            accepted => {
                Bridge.confirm-scene-name();
            }
        }
    }
    if Bridge.sheet == "scene-duplicate": Note {
        text: @tr("La nouvelle scène reprend les sources de « {} », partagées : ce sont les mêmes (même fenêtre, mêmes connexions), pas des copies. Retirer une source d'une scène ne la retire pas de l'autre.", Bridge.scene-name);
    }
    Footer {
        ActionButton {
            text: @tr("Annuler");
            kind: "ghost";
            clicked => {
                Bridge.close-sheet();
            }
        }
        ActionButton {
            text: Bridge.sheet == "scene-new" ? @tr("Créer") : Bridge.sheet == "scene-duplicate" ? @tr("Dupliquer") : @tr("Renommer");
            kind: "primary";
            enabled: Bridge.scene-name-input != "";
            clicked => {
                Bridge.confirm-scene-name();
            }
        }
    }
}

export component ConfirmSheet inherits Sheet {
    title: Bridge.confirm-title;
    sheet-width: 460px;
    close => {
        Bridge.close-sheet();
    }

    Text {
        text: Bridge.confirm-text;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    Footer {
        ActionButton {
            text: @tr("Annuler");
            kind: "ghost";
            clicked => {
                Bridge.close-sheet();
            }
        }
        ActionButton {
            text: Bridge.confirm-button;
            kind: Bridge.confirm-danger ? "danger" : "primary";
            clicked => {
                Bridge.confirm-accepted();
            }
        }
    }
}

// Fermeture de la fenêtre alors qu'une programmation est prévue.
export component CloseSchedulesSheet inherits Sheet {
    title: @tr("Programmation active");
    sheet-width: 560px;
    close => {
        Bridge.close-sheet();
    }

    Text {
        text: Bridge.close-text;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    CheckBox {
        text: @tr("Se souvenir de mon choix");
        checked <=> Bridge.close-remember;
    }
    Text {
        text: @tr("Modifiable ensuite dans les réglages.");
        color: Theme.text-muted;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }
    Footer {
        ActionButton {
            text: @tr("Annuler");
            kind: "ghost";
            clicked => {
                Bridge.close-sheet();
            }
        }
        ActionButton {
            text: @tr("Quitter quand même");
            kind: "danger";
            clicked => {
                Bridge.close-anyway();
            }
        }
        ActionButton {
            text: @tr("Continuer en arrière-plan");
            kind: "primary";
            clicked => {
                Bridge.close-to-background();
            }
        }
    }
}

// Bilan d'un enregistrement interrompu, au lancement suivant.
export component IncidentSheet inherits Sheet {
    title: @tr("Enregistrement interrompu");
    sheet-width: 640px;
    close => {
        Bridge.close-sheet();
    }

    Text {
        text: Bridge.incident-text;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    if Bridge.incident-files.length > 0: Rectangle {
        height: min(Bridge.incident-files.length * 38px + 8px, 236px);
        background: Theme.surface-raised;
        border-radius: Theme.radius-small;
        border-width: 1px;
        border-color: Theme.border;
        ListView {
            for file in Bridge.incident-files: ListRow {
                text: file.name;
                detail: file.detail;
                enabled: false;
            }
        }
    }
    if Bridge.incident-can-repair: Note {
        tone: 2;
        text: @tr("« Réparer » recopie les fichiers interrompus sans réencodage pour reconstruire leur durée et leur index. Chaque original n'est remplacé qu'une fois sa copie vérifiée.");
    }
    Footer {
        ActionButton {
            text: @tr("Signaler ce problème");
            kind: "ghost";
            clicked => {
                Bridge.request-report(true);
            }
        }
        ActionButton {
            text: @tr("Fermer");
            kind: "ghost";
            clicked => {
                Bridge.close-sheet();
            }
        }
        if Bridge.incident-can-repair: ActionButton {
            text: @tr("Réparer les fichiers");
            clicked => {
                Bridge.incident-repair();
            }
        }
        if Bridge.incident-can-resume: ActionButton {
            text: @tr("Reprendre l'enregistrement");
            kind: "primary";
            clicked => {
                Bridge.incident-resume();
            }
        }
    }
}

// Signalement d'un problème : rapport à joindre à une issue GitHub.
export component ReportSheet inherits Sheet {
    title: @tr("Signaler un problème");
    sheet-width: 560px;
    close => {
        Bridge.close-sheet();
    }

    // Avant : ce que contient le rapport ; après : comment le joindre.
    property <bool> ready: Bridge.report-path != "";
    if !root.ready: Text {
        text: @tr("Polyptyque prépare un rapport à joindre au signalement, sur GitHub. Il contient :");
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    if !root.ready: Text {
        text: @tr("• les versions de Polyptyque et de Windows, et la carte graphique ;\n• les réglages d'enregistrement, sans aucun chemin de dossier ;\n• les erreurs récentes de la carte graphique relevées par Windows ;\n• les journaux des trois derniers lancements et du dernier enregistrement.");
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    if !root.ready: Note {
        tone: 2;
        text: @tr("Un signalement sur GitHub est public et demande un compte GitHub. Le dossier personnel et le nom du compte Windows sont masqués ; les noms des scènes et des sources restent visibles. Le rapport peut être relu avant d'être joint.");
    }
    if root.ready: Text {
        text: @tr("Rapport prêt. Pour terminer :");
        color: Theme.text;
        wrap: word-wrap;
    }
    if root.ready: Text {
        text: @tr("1. Décrire le problème dans la page GitHub qui vient de s'ouvrir.\n2. Glisser le fichier du rapport, sélectionné dans l'Explorateur, dans le champ « Rapport » de la page.");
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    if root.ready: Text {
        text: Bridge.report-name;
        color: Theme.text-faint;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }
    Footer {
        if !root.ready: ActionButton {
            text: @tr("Annuler");
            kind: "ghost";
            clicked => {
                Bridge.close-sheet();
            }
        }
        if !root.ready: ActionButton {
            text: @tr("Préparer le signalement");
            kind: "primary";
            clicked => {
                Bridge.prepare-report();
            }
        }
        if root.ready: ActionButton {
            text: @tr("Relire le rapport");
            kind: "ghost";
            clicked => {
                Bridge.open-report();
            }
        }
        if root.ready: ActionButton {
            text: @tr("Rouvrir la page GitHub");
            clicked => {
                Bridge.open-report-page();
            }
        }
        if root.ready: ActionButton {
            text: @tr("Fermer");
            kind: "primary";
            clicked => {
                Bridge.close-sheet();
            }
        }
    }
}

export component SettingsSheet inherits Sheet {
    title: @tr("Réglages");
    sheet-width: 780px;
    close => {
        Bridge.close-sheet();
    }

    // Seules les deux colonnes défilent quand la fenêtre est petite : le bas
    // (version, signalement, boutons) reste toujours visible.
    scroller := ScrollView {
        max-height: max(160px, root.available-height - footer-row.preferred-height - 16px
            - (Bridge.settings-error != "" ? 64px : 0px));
        preferred-height: columns.preferred-height;
        content-width: self.visible-width;
        content-height: columns.preferred-height;
        // Deux colonnes de même largeur, remplies de haut en bas.
        columns := HorizontalLayout {
            width: scroller.visible-width;
            // Place de la barre de défilement, hors des champs.
            padding-right: 14px;
            spacing: 28px;
            VerticalLayout {
                spacing: 14px;
                alignment: start;
                horizontal-stretch: 1;
                preferred-width: 0px;
                Text {
                    text: @tr("Enregistrement");
                    color: Theme.text;
                    font-weight: 700;
                }
                Field {
                    label: @tr("Résolution");
                    ComboBox {
                        model: Bridge.resolution-choices;
                        current-index <=> Bridge.resolution-index;
                    }
                }
                Field {
                    label: @tr("Images par seconde");
                    ComboBox {
                        model: Bridge.fps-choices;
                        current-index <=> Bridge.fps-index;
                    }
                }
                Field {
                    label: @tr("Débit vidéo (kb/s)");
                    hint: @tr("En 1080p à 60 i/s : 6 000 léger, 12 000 bon, 20 000 très bon.");
                    LineEdit {
                        text <=> Bridge.bitrate-text;
                        input-type: number;
                    }
                }
                Field {
                    label: @tr("Format vidéo");
                    ComboBox {
                        model: Bridge.codec-choices;
                        current-index <=> Bridge.codec-index;
                    }
                }
                Field {
                    label: @tr("Matériel d'encodage");
                    ComboBox {
                        model: Bridge.hardware-choices;
                        current-index <=> Bridge.hardware-index;
                    }
                }
                Field {
                    label: @tr("Débit audio");
                    ComboBox {
                        model: Bridge.audio-choices;
                        current-index <=> Bridge.audio-index;
                    }
                }
                Field {
                    label: @tr("Micro");
                    Toggle {
                        text: @tr("Enregistrer le micro dans un fichier séparé");
                        checked: Bridge.settings-mic;
                        toggled(value) => {
                            Bridge.settings-mic = value;
                        }
                    }
                }
                if Bridge.settings-mic: ComboBox {
                    model: Bridge.mic-choices;
                    current-index <=> Bridge.mic-index;
                }
                // Le micro choisi est écouté tant que les réglages sont ouverts.
                if Bridge.settings-mic: HorizontalLayout {
                    spacing: 10px;
                    LevelMeter {
                        width: 120px;
                        y: (parent.height - self.height) / 2;
                        level: Bridge.mic-test-level;
                        active: Bridge.mic-test-sound;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: Bridge.mic-test-error != "" ? Bridge.mic-test-error
                            : Bridge.mic-test-sound ? @tr("Son capté") : @tr("Aucun son capté : parler dans le micro pour vérifier");
                        color: Bridge.mic-test-error != "" ? Theme.warning : Theme.text-faint;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
                if Bridge.settings-mic: Note {
                    text: @tr("Le son de ce micro sera enregistré pendant chaque enregistrement, dans son propre fichier (.mka), calé sur les vidéos. Windows doit autoriser l'accès au micro pour les applications de bureau.");
                }
                if Bridge.settings-mic && Bridge.can-browse: HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        text: @tr("Autorisations du micro dans Windows");
                        icon: @image-url("icons/launch.svg");
                        has-icon: true;
                        kind: "ghost";
                        clicked => {
                            Bridge.open-mic-privacy();
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 14px;
                alignment: start;
                horizontal-stretch: 1;
                preferred-width: 0px;
                Text {
                    text: @tr("Fichiers et interface");
                    color: Theme.text;
                    font-weight: 700;
                }
                Field {
                    label: @tr("Langue");
                    ComboBox {
                        // Chaque langue écrite dans sa propre langue.
                        model: [@tr("Automatique (langue de Windows)"), "Français", "English"];
                        current-index <=> Bridge.settings-language-index;
                    }
                }
                Field {
                    label: @tr("Horloge");
                    ComboBox {
                        model: [@tr("Automatique (comme Windows)"), @tr("24 h (21:00)"), @tr("12 h (9:00 PM)")];
                        current-index <=> Bridge.settings-clock-index;
                    }
                }
                Field {
                    label: @tr("Dossier des enregistrements");
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            text <=> Bridge.output-dir;
                            horizontal-stretch: 1;
                        }
                        if Bridge.can-browse: ActionButton {
                            text: @tr("Parcourir…");
                            clicked => {
                                Bridge.browse-output();
                            }
                        }
                    }
                }
                Field {
                    label: @tr("Modèle de nom de fichier");
                    hint: @tr("Variables : {{date}}, {{heure}}, {{scène}}, {{source}}.");
                    LineEdit {
                        text <=> Bridge.template;
                    }
                }
                Toggle {
                    text: @tr("Aperçus en direct des sources");
                    checked: Bridge.settings-previews;
                    toggled(value) => {
                        Bridge.settings-previews = value;
                    }
                }
                Toggle {
                    text: @tr("Ouvrir les fenêtres de la scène au lancement");
                    checked: Bridge.settings-open-windows;
                    toggled(value) => {
                        Bridge.settings-open-windows = value;
                    }
                }
                Toggle {
                    text: @tr("Fermer les navigateurs des sources en quittant");
                    checked: Bridge.settings-close-browsers;
                    toggled(value) => {
                        Bridge.settings-close-browsers = value;
                    }
                }
                Toggle {
                    text: @tr("Lancer Polyptyque au démarrage de Windows");
                    checked: Bridge.settings-startup;
                    toggled(value) => {
                        Bridge.settings-startup = value;
                    }
                }
                Field {
                    label: @tr("Fermer la fenêtre avec une programmation prévue");
                    hint: @tr("Polyptyque doit rester ouvert pour lancer les programmations. En arrière-plan, son icône reste près de l'horloge : un clic l'affiche, un clic droit permet de le quitter.");
                    ComboBox {
                        model: [@tr("Demander à chaque fois"), @tr("Continuer en arrière-plan"), @tr("Quitter Polyptyque")];
                        current-index <=> Bridge.settings-close-index;
                    }
                }
                Field {
                    label: @tr("Conversion pour le montage");
                    hint: @tr("Copie MP4 sans perte de qualité, créée à côté du MKV, qui est conservé. Prévoir le double d'espace disque.");
                    Toggle {
                        text: @tr("Convertir en MP4 à la fin de l'enregistrement");
                        checked: Bridge.settings-convert;
                        toggled(value) => {
                            Bridge.settings-convert = value;
                        }
                    }
                }
                Field {
                    label: @tr("Mises à jour");
                    hint: @tr("Revenir aux versions stables ne réinstalle pas une version plus ancienne : la bêta reste jusqu'à la prochaine version stable.");
                    ComboBox {
                        model: [@tr("Versions stables"), @tr("Versions stables et bêta"), @tr("Ne pas rechercher")];
                        current-index <=> Bridge.settings-update-index;
                    }
                }
                Field {
                    label: @tr("Pilotage");
                    hint: @tr("Un assistant IA, un script ou un Stream Deck peut alors tout régler et lancer un enregistrement. Seuls les programmes de ce compte Windows, sur cet ordinateur, y ont accès, jamais une page web ; un enregistrement reste toujours signalé.");
                    Toggle {
                        text: @tr("Autoriser le pilotage par d'autres programmes");
                        checked: Bridge.settings-remote-control;
                        toggled(value) => {
                            Bridge.settings-remote-control = value;
                        }
                    }
                }
                if Bridge.settings-remote-control: HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        text: @tr("Connecter un assistant IA…");
                        kind: "ghost";
                        clicked => {
                            Bridge.open-control-help();
                        }
                    }
                }
                Field {
                    label: @tr("Raccourci : démarrer ou arrêter l'enregistrement");
                    ComboBox {
                        model: Bridge.hotkey-choices;
                        current-index <=> Bridge.hotkey-record-index;
                    }
                }
                Field {
                    label: @tr("Raccourci : afficher ou réduire Polyptyque");
                    ComboBox {
                        model: Bridge.hotkey-choices;
                        current-index <=> Bridge.hotkey-show-index;
                    }
                }
                Field {
                    label: @tr("Raccourci : activer ou couper les aperçus");
                    ComboBox {
                        model: Bridge.hotkey-choices;
                        current-index <=> Bridge.hotkey-previews-index;
                    }
                }
            }
        }
    }
    if Bridge.settings-error != "": Note {
        tone: 3;
        text: Bridge.settings-error;
    }
    footer-row := HorizontalLayout {
        spacing: 10px;
        Text {
            text: "Polyptyque \{Bridge.version}";
            color: Theme.text-faint;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            padding-top: 6px;
            ActionButton {
                text: @tr("Signaler un problème…");
                kind: "ghost";
                clicked => {
                    Bridge.request-report(false);
                }
            }
        }
        Footer {
            ActionButton {
                text: @tr("Annuler");
                kind: "ghost";
                clicked => {
                    Bridge.close-sheet();
                }
            }
            ActionButton {
                text: @tr("Enregistrer");
                kind: "primary";
                clicked => {
                    Bridge.save-settings();
                }
            }
        }
    }
}

// Le branchement se fait ici ; l'échange reste dans l'assistant habituel.
export component AssistantsSheet inherits Sheet {
    property <bool> show-options: false;
    title: @tr("Connecter un assistant IA");
    sheet-width: 720px;
    close => { Bridge.close-assistants(); }

    Note {
        text: @tr("Choisir un assistant installé sur ce PC. Polyptyque prépare sa connexion ; les échanges et le compte IA restent dans cet assistant.");
    }
    for assistant in Bridge.assistants: Rectangle {
        background: Theme.surface-raised;
        border-radius: Theme.radius-small;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: assistant.name;
                    color: Theme.text;
                    font-size: Theme.font-normal;
                    font-weight: 600;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Text {
                    text: assistant.state;
                    color: assistant.tone == 0 ? Theme.text-muted : Theme.tone-color(assistant.tone);
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
                if !assistant.configured || assistant.needs-repair || root.show-options: ActionButton {
                    text: assistant.needs-repair ? @tr("Réparer") : assistant.configured ? @tr("Réinstaller la connexion") : @tr("Connecter");
                    kind: assistant.configured ? "secondary" : "primary";
                    enabled: assistant.can-connect && !Bridge.assistants-busy;
                    clicked => { Bridge.configure-assistant(assistant.id, false); }
                }
            }
            Text {
                text: assistant.detail;
                color: Theme.text-muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
            if root.show-options || !assistant.can-connect || assistant.can-disconnect: HorizontalLayout {
                alignment: end;
                spacing: 8px;
                if root.show-options || !assistant.can-connect: ActionButton {
                    text: @tr("Choisir la configuration…");
                    kind: "ghost";
                    enabled: !Bridge.assistants-busy;
                    clicked => { Bridge.browse-assistant-config(assistant.id); }
                }
                if assistant.can-disconnect: ActionButton {
                    text: @tr("Déconnecter");
                    kind: "ghost";
                    enabled: !Bridge.assistants-busy;
                    clicked => { Bridge.configure-assistant(assistant.id, true); }
                }
            }
        }
    }
    if Bridge.assistants-busy: Text {
        text: @tr("Vérification des connexions…");
        color: Theme.text-muted;
        font-size: Theme.font-small;
    }
    if Bridge.assistants-message != "": Note {
        text: Bridge.assistants-message;
        tone: Bridge.assistants-message-tone;
    }
    Field {
        label: @tr("Vérifier depuis l'assistant");
        hint: @tr("Suivre les étapes de l'assistant choisi, puis envoyer cette demande. « Configuration enregistrée » indique que Polyptyque a terminé sa préparation ; « Connecté » apparaît après l'utilisation d'un outil. Aucun clic sur Réparer n'est nécessaire pour terminer la connexion.");
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: @tr("Liste mes scènes dans Polyptyque.");
                color: Theme.text;
                font-size: Theme.font-normal;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
            ActionButton {
                text: @tr("Copier la demande");
                clicked => { Bridge.copy-assistant-prompt(); }
            }
        }
    }
    if root.show-options: Note {
        text: @tr("Installations Windows natives uniquement. WSL, Docker et les serveurs distants demandent une configuration particulière. Les autres réglages sont conservés ; une sauvegarde garde le fichier original. Les commentaires JSON5 et YAML ne sont pas conservés dans le fichier modifié.");
    }
    Footer {
        ActionButton {
            text: root.show-options ? @tr("Masquer les options") : @tr("Options de connexion");
            kind: "ghost";
            clicked => { root.show-options = !root.show-options; }
        }
        ActionButton {
            text: @tr("Actualiser");
            enabled: !Bridge.assistants-busy;
            clicked => { Bridge.refresh-assistants(); }
        }
        ActionButton {
            text: @tr("Retour aux réglages");
            clicked => { Bridge.close-assistants(); }
        }
    }
}

// Opération en cours (recherche de l'encodeur, finalisation des fichiers…).
export component BusyOverlay inherits Rectangle {
    background: Theme.backdrop;
    TouchArea { }
    Rectangle {
        width: 420px;
        height: 150px;
        background: Theme.surface;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Spinner {
                    indeterminate: true;
                    width: 36px;
                    height: 36px;
                }
            }
            Text {
                text: Bridge.busy-text;
                color: Theme.text;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

// Message temporaire en bas de la fenêtre.
export component Toast inherits Rectangle {
    width: min(row.preferred-width, 760px);
    height: row.preferred-height;
    border-radius: Theme.radius;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.tone-color(Bridge.toast-tone).with-alpha(0.6);
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000080;

    row := HorizontalLayout {
        padding: 12px;
        padding-left: 16px;
        spacing: 12px;
        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: Theme.tone-color(Bridge.toast-tone);
        }
        Text {
            text: Bridge.toast-text;
            color: Theme.text;
            wrap: word-wrap;
            vertical-alignment: center;
            max-width: 680px;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Bridge.dismiss-toast();
        }
    }
}

// Programmation dans la liste : activée ou non, description, prochain
// créneau, boutons pour la modifier ou la supprimer.
component ScheduleRow inherits Rectangle {
    in property <ScheduleItem> item;

    height: 58px;
    border-radius: Theme.radius-small;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: root.item.locked ? Theme.recording.with-alpha(0.55) : Theme.border;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Toggle {
                width: 36px;
                text: "";
                checked: root.item.enabled;
                opacity: root.item.locked ? 0.4 : 1;
                accessible-label: root.item.enabled ? @tr("Désactiver la programmation") : @tr("Activer la programmation");
                toggled(value) => {
                    if !root.item.locked {
                        Bridge.toggle-schedule(root.item.id, value);
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: "\{root.item.scene} · \{root.item.times}";
                color: root.item.enabled ? Theme.text : Theme.text-muted;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: "\{root.item.repeat} · \{root.item.next}";
                color: root.item.locked ? Theme.recording : Theme.text-faint;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: @image-url("icons/edit.svg");
            label: @tr("Modifier la programmation");
            enabled: !root.item.locked;
            clicked => {
                Bridge.edit-schedule(root.item.id);
            }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: @image-url("icons/trash.svg");
            label: @tr("Supprimer la programmation");
            enabled: !root.item.locked;
            clicked => {
                Bridge.delete-schedule(root.item.id);
            }
        }
    }
}

// Liste des programmations et lancement au démarrage de Windows.
export component SchedulesSheet inherits Sheet {
    title: @tr("Programmations");
    sheet-width: 640px;
    close => {
        Bridge.close-sheet();
    }

    Text {
        text: @tr("Polyptyque lance et arrête lui-même l'enregistrement d'une scène aux heures prévues. Il doit rester ouvert pour cela ; tant qu'une programmation est active, l'ordinateur et l'écran ne se mettent pas en veille d'eux-mêmes.");
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    if Bridge.schedules.length == 0: Text {
        text: @tr("Aucune programmation pour l'instant.");
        color: Theme.text-faint;
    }
    if Bridge.schedules.length > 0: VerticalLayout {
        spacing: 8px;
        for item in Bridge.schedules: ScheduleRow {
            item: item;
        }
    }
    HorizontalLayout {
        alignment: start;
        ActionButton {
            text: @tr("Nouvelle programmation");
            icon: @image-url("icons/plus.svg");
            has-icon: true;
            kind: "primary";
            clicked => {
                Bridge.edit-schedule("");
            }
        }
    }
    Field {
        label: @tr("Démarrage de Windows");
        hint: @tr("Sans cela, après un redémarrage de Windows (une mise à jour, par exemple), les programmations attendent la réouverture de Polyptyque. Lancé par Windows, il démarre en arrière-plan (icône près de l'horloge), sans ouvrir les fenêtres de la scène.");
        Toggle {
            text: @tr("Lancer Polyptyque au démarrage de Windows");
            checked: Bridge.startup-enabled;
            toggled(value) => {
                Bridge.set-launch-at-startup(value);
            }
        }
    }
    if Bridge.startup-note != "": Note {
        tone: 2;
        text: Bridge.startup-note;
    }
    Footer {
        ActionButton {
            text: @tr("Fermer");
            kind: "ghost";
            clicked => {
                Bridge.close-sheet();
            }
        }
    }
}

// Jour de la semaine à cocher.
component DayChip inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <bool> selected;
    callback clicked;

    width: 38px;
    height: 34px;
    border-radius: Theme.radius-small;
    background: root.selected ? (touch.has-hover ? Theme.accent-hover : Theme.accent)
        : (touch.has-hover ? Theme.surface-hover : Theme.surface-raised);
    border-width: root.selected ? 0 : 1px;
    border-color: Theme.border;
    accessible-role: checkbox;
    accessible-checked: root.selected;
    accessible-label: root.label;
    animate background { duration: 120ms; }

    Text {
        text: root.text;
        color: root.selected ? #ffffff : Theme.text;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Formulaire d'une programmation.
// Jour d'une date, dans le formulaire d'une programmation.
component DayList inherits ComboBox {
    model: Bridge.schedule-day-choices;
    current-index <=> Bridge.schedule-day-index;
    accessible-label: @tr("Jour");
    min-width: 76px;
    horizontal-stretch: 0;
    selected => {
        Bridge.schedule-date-edited();
    }
}

export component ScheduleEditorSheet inherits Sheet {
    property <[string]> day-letters: [
        @tr("Initiale du lundi" => "L"),
        @tr("Initiale du mardi" => "M"),
        @tr("Initiale du mercredi" => "M"),
        @tr("Initiale du jeudi" => "J"),
        @tr("Initiale du vendredi" => "V"),
        @tr("Initiale du samedi" => "S"),
        @tr("Initiale du dimanche" => "D"),
    ];
    property <[string]> day-names: [@tr("lundi"), @tr("mardi"), @tr("mercredi"), @tr("jeudi"), @tr("vendredi"), @tr("samedi"), @tr("dimanche")];

    title: Bridge.sheet == "schedule-new" ? @tr("Nouvelle programmation") : @tr("Modifier la programmation");
    sheet-width: 520px;
    close => {
        Bridge.close-schedule-editor();
    }

    Field {
        label: @tr("Scène à enregistrer");
        ComboBox {
            model: Bridge.schedule-scene-choices;
            current-index <=> Bridge.schedule-scene-index;
        }
    }
    HorizontalLayout {
        spacing: 12px;
        Field {
            label: @tr("Début");
            horizontal-stretch: 1;
            LineEdit {
                text <=> Bridge.schedule-start;
                placeholder-text: Bridge.twelve-hour ? "9:00 PM" : "21:00";
                edited(text) => {
                    Bridge.schedule-times-edited();
                }
            }
        }
        Field {
            label: @tr("Fin");
            horizontal-stretch: 1;
            LineEdit {
                text <=> Bridge.schedule-end;
                placeholder-text: Bridge.twelve-hour ? "10:30 PM" : "22:30";
                edited(text) => {
                    Bridge.schedule-times-edited();
                }
            }
        }
    }
    if Bridge.schedule-times-note != "": Text {
        text: Bridge.schedule-times-note;
        color: Theme.text-faint;
        font-size: Theme.font-small;
    }
    Field {
        label: @tr("Répétition");
        ComboBox {
            model: [@tr("Une seule fois"), @tr("Tous les jours"), @tr("Certains jours de la semaine")];
            current-index <=> Bridge.schedule-repeat-index;
        }
    }
    // Trois listes plutôt qu'un sélecteur de date : celui de Slint commence
    // la semaine le dimanche et écrit les mois en anglais. Ordre de la
    // langue : « 25 octobre 2026 », « October 25, 2026 ».
    if Bridge.schedule-repeat-index == 0: Field {
        label: @tr("Date");
        hint: Bridge.schedule-date-note;
        HorizontalLayout {
            spacing: 8px;
            if !Bridge.month-first: DayList { }
            ComboBox {
                model: Bridge.schedule-month-choices;
                current-index <=> Bridge.schedule-month-index;
                accessible-label: @tr("Mois");
                min-width: 140px;
                horizontal-stretch: 1;
                selected => {
                    Bridge.schedule-date-edited();
                }
            }
            if Bridge.month-first: DayList { }
            ComboBox {
                model: Bridge.schedule-year-choices;
                current-index <=> Bridge.schedule-year-index;
                accessible-label: @tr("Année");
                min-width: 96px;
                horizontal-stretch: 0;
                selected => {
                    Bridge.schedule-date-edited();
                }
            }
        }
    }
    if Bridge.schedule-repeat-index == 2: Field {
        label: @tr("Jours où le créneau commence");
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for letter[index] in root.day-letters: DayChip {
                text: letter;
                label: root.day-names[index];
                selected: Bridge.schedule-days[index];
                clicked => {
                    Bridge.toggle-schedule-day(index);
                }
            }
        }
    }
    Note {
        text: @tr("Polyptyque doit être ouvert à l'heure prévue. S'il était fermé, ou l'ordinateur en veille, il demande à son retour s'il faut lancer l'enregistrement : sans réponse au bout de deux minutes, il le lance.");
    }
    if Bridge.schedule-error != "": Note {
        tone: 3;
        text: Bridge.schedule-error;
    }
    Footer {
        ActionButton {
            text: @tr("Annuler");
            kind: "ghost";
            clicked => {
                Bridge.close-schedule-editor();
            }
        }
        ActionButton {
            text: @tr("Enregistrer");
            kind: "primary";
            clicked => {
                Bridge.save-schedule();
            }
        }
    }
}

// Question de la programmation (démarrage manqué, lancement à la main
// pendant un créneau, information), au-dessus de tout, avec son compte à
// rebours.
export component SchedulePrompt inherits Sheet {
    title: Bridge.prompt-title;
    sheet-width: 500px;
    close => {
        if Bridge.prompt-decline != "" {
            Bridge.prompt-declined();
        } else {
            Bridge.prompt-accepted();
        }
    }

    Text {
        text: Bridge.prompt-text;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    if Bridge.prompt-countdown != "": HorizontalLayout {
        spacing: 8px;
        Image {
            source: @image-url("icons/clock.svg");
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.accent;
        }
        Text {
            horizontal-stretch: 1;
            text: Bridge.prompt-countdown;
            color: Theme.accent;
            font-weight: 600;
            wrap: word-wrap;
        }
    }
    Footer {
        if Bridge.prompt-decline != "": ActionButton {
            text: Bridge.prompt-decline;
            kind: "ghost";
            clicked => {
                Bridge.prompt-declined();
            }
        }
        ActionButton {
            text: Bridge.prompt-accept;
            kind: "primary";
            clicked => {
                Bridge.prompt-accepted();
            }
        }
    }
}

// Poignée du cadre de rognage, centrée sur (cx, cy).
component CropKnob inherits Rectangle {
    in property <length> cx;
    in property <length> cy;
    in property <bool> selected;
    x: root.cx - self.width / 2;
    y: root.cy - self.height / 2;
    width: 12px;
    height: 12px;
    border-radius: 2px;
    background: root.selected ? Theme.accent : #ffffff;
    border-width: 1px;
    border-color: root.selected ? #ffffff : Theme.accent;
}

// Marge retirée d'un bord, en pixels de la fenêtre.
component MarginField inherits Field {
    // 0 gauche, 1 haut, 2 droite, 3 bas.
    in property <int> side;
    in property <int> maximum;
    in property <bool> enabled;
    in-out property <int> value;
    horizontal-stretch: 1;
    SpinBox {
        minimum: 0;
        maximum: root.maximum;
        enabled: root.enabled;
        value <=> root.value;
        edited(value) => {
            Bridge.crop-margin-edited(root.side, value);
        }
    }
}

// Rognage d'une source : la fenêtre entière, la zone gardée encadrée (le
// reste assombri). Le cadre se déplace d'un bloc, ses bords et ses coins le
// redimensionnent, à la souris ou au clavier ; les marges se saisissent
// aussi en pixels. Rien n'est enregistré avant « Appliquer ».
export component CropSheet inherits Sheet {
    title: @tr("Rogner « {} »", Bridge.crop-source-name);
    sheet-width: min(root.width - 48px, 980px);
    close => {
        Bridge.close-sheet();
    }
    init => {
        keys.focus();
    }

    // Ce que déplacent les flèches du clavier.
    property <string> handle-name: Bridge.crop-handle == 1 ? @tr("le coin en haut à gauche")
        : Bridge.crop-handle == 2 ? @tr("le bord du haut")
        : Bridge.crop-handle == 3 ? @tr("le coin en haut à droite")
        : Bridge.crop-handle == 4 ? @tr("le bord de droite")
        : Bridge.crop-handle == 5 ? @tr("le coin en bas à droite")
        : Bridge.crop-handle == 6 ? @tr("le bord du bas")
        : Bridge.crop-handle == 7 ? @tr("le coin en bas à gauche")
        : Bridge.crop-handle == 8 ? @tr("le bord de gauche")
        : @tr("le cadre entier");
    property <int> kept-width: Bridge.crop-window-width - Bridge.crop-left - Bridge.crop-right;
    property <int> kept-height: Bridge.crop-window-height - Bridge.crop-top - Bridge.crop-bottom;

    keys := FocusScope {
        min-height: column.min-height;
        preferred-height: column.preferred-height;
        key-pressed(event) => {
            if event.text == Key.Return {
                Bridge.crop-apply();
                return accept;
            }
            if !stage.active {
                return reject;
            }
            if event.text == Key.LeftArrow {
                Bridge.crop-nudge(event.modifiers.shift ? -10 : -1, 0);
                return accept;
            }
            if event.text == Key.RightArrow {
                Bridge.crop-nudge(event.modifiers.shift ? 10 : 1, 0);
                return accept;
            }
            if event.text == Key.UpArrow {
                Bridge.crop-nudge(0, event.modifiers.shift ? -10 : -1);
                return accept;
            }
            if event.text == Key.DownArrow {
                Bridge.crop-nudge(0, event.modifiers.shift ? 10 : 1);
                return accept;
            }
            if event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift) {
                Bridge.crop-handle = Math.mod(Bridge.crop-handle + 8, 9);
                return accept;
            }
            if event.text == Key.Tab {
                Bridge.crop-handle = Math.mod(Bridge.crop-handle + 1, 9);
                return accept;
            }
            return reject;
        }

        column := VerticalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 14px;

            stage := Rectangle {
                height: 400px;
                background: Theme.preview-background;
                border-radius: Theme.radius-small;
                clip: true;

                property <bool> known: Bridge.crop-window-width > 0 && Bridge.crop-window-height > 0;
                property <bool> active: self.known && Bridge.crop-has-image;
                property <float> win-w: max(1, Bridge.crop-window-width);
                property <float> win-h: max(1, Bridge.crop-window-height);
                // Longueur à l'écran d'un pixel de la fenêtre.
                property <length> unit: min((self.width - 32px) / self.win-w, (self.height - 32px) / self.win-h);
                property <length> img-w: self.win-w * self.unit;
                property <length> img-h: self.win-h * self.unit;
                property <length> img-x: (self.width - self.img-w) / 2;
                property <length> img-y: (self.height - self.img-h) / 2;
                // Zone gardée, à l'écran.
                property <length> cx: self.img-x + Bridge.crop-left * self.unit;
                property <length> cy: self.img-y + Bridge.crop-top * self.unit;
                property <length> cw: max(0, self.win-w - Bridge.crop-left - Bridge.crop-right) * self.unit;
                property <length> ch: max(0, self.win-h - Bridge.crop-top - Bridge.crop-bottom) * self.unit;

                // Poignée sous le pointeur : 0 dans le cadre, 1 à 8 coins et
                // bords, -1 ailleurs.
                pure function hit(x: length, y: length) -> int {
                    let t = 9px;
                    let left = abs(x - self.cx) <= t;
                    let right = abs(x - (self.cx + self.cw)) <= t;
                    let top = abs(y - self.cy) <= t;
                    let bottom = abs(y - (self.cy + self.ch)) <= t;
                    let along-x = x >= self.cx - t && x <= self.cx + self.cw + t;
                    let along-y = y >= self.cy - t && y <= self.cy + self.ch + t;
                    if top && left {
                        return 1;
                    }
                    if top && right {
                        return 3;
                    }
                    if bottom && right {
                        return 5;
                    }
                    if bottom && left {
                        return 7;
                    }
                    if top && along-x {
                        return 2;
                    }
                    if right && along-y {
                        return 4;
                    }
                    if bottom && along-x {
                        return 6;
                    }
                    if left && along-y {
                        return 8;
                    }
                    if x > self.cx && x < self.cx + self.cw && y > self.cy && y < self.cy + self.ch {
                        return 0;
                    }
                    return -1;
                }
                pure function cursor-for(handle: int) -> MouseCursor {
                    if handle == 0 {
                        return MouseCursor.move;
                    }
                    if handle == 1 || handle == 5 {
                        return MouseCursor.nwse-resize;
                    }
                    if handle == 3 || handle == 7 {
                        return MouseCursor.nesw-resize;
                    }
                    if handle == 2 || handle == 6 {
                        return MouseCursor.ns-resize;
                    }
                    if handle == 4 || handle == 8 {
                        return MouseCursor.ew-resize;
                    }
                    return MouseCursor.default;
                }

                if stage.active: Image {
                    x: stage.img-x;
                    y: stage.img-y;
                    width: stage.img-w;
                    height: stage.img-h;
                    source: Bridge.crop-image;
                    image-fit: fill;
                }

                if stage.active: Rectangle {
                    // Parties retirées, assombries.
                    Rectangle {
                        x: stage.img-x;
                        y: stage.img-y;
                        width: stage.img-w;
                        height: stage.cy - stage.img-y;
                        background: #000000b8;
                    }
                    Rectangle {
                        x: stage.img-x;
                        y: stage.cy + stage.ch;
                        width: stage.img-w;
                        height: stage.img-y + stage.img-h - stage.cy - stage.ch;
                        background: #000000b8;
                    }
                    Rectangle {
                        x: stage.img-x;
                        y: stage.cy;
                        width: stage.cx - stage.img-x;
                        height: stage.ch;
                        background: #000000b8;
                    }
                    Rectangle {
                        x: stage.cx + stage.cw;
                        y: stage.cy;
                        width: stage.img-x + stage.img-w - stage.cx - stage.cw;
                        height: stage.ch;
                        background: #000000b8;
                    }
                    // Tiers, pour cadrer.
                    for i in [1, 2]: Rectangle {
                        x: stage.cx + stage.cw * i / 3;
                        y: stage.cy;
                        width: 1px;
                        height: stage.ch;
                        background: #ffffff38;
                    }
                    for i in [1, 2]: Rectangle {
                        x: stage.cx;
                        y: stage.cy + stage.ch * i / 3;
                        width: stage.cw;
                        height: 1px;
                        background: #ffffff38;
                    }
                    Rectangle {
                        x: stage.cx;
                        y: stage.cy;
                        width: stage.cw;
                        height: stage.ch;
                        border-width: Bridge.crop-handle == 0 ? 3px : 2px;
                        border-color: Theme.accent;
                    }
                    // Bord choisi pour le clavier.
                    if Bridge.crop-handle == 2: Rectangle {
                        x: stage.cx;
                        y: stage.cy - 2px;
                        width: stage.cw;
                        height: 4px;
                        background: Theme.accent;
                    }
                    if Bridge.crop-handle == 4: Rectangle {
                        x: stage.cx + stage.cw - 2px;
                        y: stage.cy;
                        width: 4px;
                        height: stage.ch;
                        background: Theme.accent;
                    }
                    if Bridge.crop-handle == 6: Rectangle {
                        x: stage.cx;
                        y: stage.cy + stage.ch - 2px;
                        width: stage.cw;
                        height: 4px;
                        background: Theme.accent;
                    }
                    if Bridge.crop-handle == 8: Rectangle {
                        x: stage.cx - 2px;
                        y: stage.cy;
                        width: 4px;
                        height: stage.ch;
                        background: Theme.accent;
                    }
                    CropKnob {
                        cx: stage.cx;
                        cy: stage.cy;
                        selected: Bridge.crop-handle == 1;
                    }
                    CropKnob {
                        cx: stage.cx + stage.cw / 2;
                        cy: stage.cy;
                        selected: Bridge.crop-handle == 2;
                    }
                    CropKnob {
                        cx: stage.cx + stage.cw;
                        cy: stage.cy;
                        selected: Bridge.crop-handle == 3;
                    }
                    CropKnob {
                        cx: stage.cx + stage.cw;
                        cy: stage.cy + stage.ch / 2;
                        selected: Bridge.crop-handle == 4;
                    }
                    CropKnob {
                        cx: stage.cx + stage.cw;
                        cy: stage.cy + stage.ch;
                        selected: Bridge.crop-handle == 5;
                    }
                    CropKnob {
                        cx: stage.cx + stage.cw / 2;
                        cy: stage.cy + stage.ch;
                        selected: Bridge.crop-handle == 6;
                    }
                    CropKnob {
                        cx: stage.cx;
                        cy: stage.cy + stage.ch;
                        selected: Bridge.crop-handle == 7;
                    }
                    CropKnob {
                        cx: stage.cx;
                        cy: stage.cy + stage.ch / 2;
                        selected: Bridge.crop-handle == 8;
                    }
                }

                // Pas encore d'image : fenêtre recherchée, réduite ou fermée.
                if !stage.active: VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    padding: 24px;
                    Text {
                        text: Bridge.crop-placeholder != "" ? Bridge.crop-placeholder : @tr("Recherche de la fenêtre…");
                        color: Theme.text-faint;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if Bridge.crop-can-open || Bridge.crop-can-restore: HorizontalLayout {
                        alignment: center;
                        ActionButton {
                            text: Bridge.crop-can-restore ? @tr("Rétablir la fenêtre") : @tr("Ouvrir la fenêtre");
                            icon: Bridge.crop-can-restore ? @image-url("icons/restore.svg") : @image-url("icons/launch.svg");
                            has-icon: true;
                            clicked => {
                                if Bridge.crop-can-restore {
                                    Bridge.restore-window(Bridge.crop-source-id);
                                } else {
                                    Bridge.open-source(Bridge.crop-source-id);
                                }
                            }
                        }
                    }
                }

                touch := TouchArea {
                    enabled: stage.active;
                    // Poignée attrapée à l'appui (-1 : aucune).
                    property <int> grabbed: -1;
                    mouse-cursor: stage.cursor-for(self.pressed ? self.grabbed : stage.hit(self.mouse-x, self.mouse-y));
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                            keys.focus();
                            self.grabbed = stage.hit(self.mouse-x, self.mouse-y);
                            if self.grabbed >= 0 {
                                Bridge.crop-handle = self.grabbed;
                                Bridge.crop-drag-start();
                            }
                        }
                    }
                    moved => {
                        if self.pressed && self.grabbed >= 0 {
                            Bridge.crop-drag(
                                self.grabbed,
                                Math.round((self.mouse-x - self.pressed-x) / stage.unit),
                                Math.round((self.mouse-y - self.pressed-y) / stage.unit));
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                Field {
                    label: @tr("Format");
                    horizontal-stretch: 2;
                    ComboBox {
                        model: Bridge.crop-ratio-choices;
                        current-index <=> Bridge.crop-ratio-index;
                        selected(value) => {
                            Bridge.crop-ratio-selected(self.current-index);
                            keys.focus();
                        }
                    }
                }
                MarginField {
                    label: @tr("Gauche (px)");
                    side: 0;
                    maximum: stage.known ? Bridge.crop-window-width : 100000;
                    enabled: stage.known;
                    value <=> Bridge.crop-left;
                }
                MarginField {
                    label: @tr("Haut (px)");
                    side: 1;
                    maximum: stage.known ? Bridge.crop-window-height : 100000;
                    enabled: stage.known;
                    value <=> Bridge.crop-top;
                }
                MarginField {
                    label: @tr("Droite (px)");
                    side: 2;
                    maximum: stage.known ? Bridge.crop-window-width : 100000;
                    enabled: stage.known;
                    value <=> Bridge.crop-right;
                }
                MarginField {
                    label: @tr("Bas (px)");
                    side: 3;
                    maximum: stage.known ? Bridge.crop-window-height : 100000;
                    enabled: stage.known;
                    value <=> Bridge.crop-bottom;
                }
            }

            if stage.known: Text {
                text: @tr("Zone gardée : {} × {} pixels, sur une fenêtre de {} × {}.", root.kept-width, root.kept-height, Bridge.crop-window-width, Bridge.crop-window-height);
                color: Theme.text-muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
            Note {
                text: @tr("Au clavier : les flèches déplacent {} d'un pixel (Maj : 10 pixels), Tab passe au bord ou au coin suivant, Entrée applique. Si la fenêtre change de taille, les marges restent comptées depuis chaque bord. Une zone qui n'a pas le format de l'enregistrement y est centrée entre des bandes noires.", root.handle-name);
            }

            Footer {
                ActionButton {
                    text: @tr("Réinitialiser");
                    kind: "ghost";
                    clicked => {
                        Bridge.crop-reset();
                        keys.focus();
                    }
                }
                ActionButton {
                    text: @tr("Annuler");
                    kind: "ghost";
                    clicked => {
                        Bridge.close-sheet();
                    }
                }
                ActionButton {
                    text: @tr("Appliquer");
                    kind: "primary";
                    clicked => {
                        Bridge.crop-apply();
                    }
                }
            }
        }
    }
}