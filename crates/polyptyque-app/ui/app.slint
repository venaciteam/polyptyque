// Fenêtre principale de Polyptyque.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Bridge, IncidentFile, SceneItem, ScheduleItem, SourceItem, SourceCard, WindowItem } from "bridge.slint";
import { ActionButton, IconButton, LevelMeter, ListRow, Panel, SourceCardView, Toggle } from "components.slint";
import {
    AddApplicationSheet, AddBrowserSheet, BusyOverlay, ConfirmSheet, IncidentSheet, ReportSheet, SceneNameSheet,
    ScheduleEditorSheet, SchedulePrompt, SchedulesSheet, SettingsSheet, Toast,
} from "sheets.slint";

export { Bridge, IncidentFile, SceneItem, ScheduleItem, SourceItem, SourceCard, WindowItem }

// Logo : trois panneaux, comme un polyptyque.
component Logo inherits HorizontalLayout {
    spacing: 3px;
    height: 24px;
    Rectangle {
        width: 7px;
        border-radius: 2px;
        background: Theme.accent.with-alpha(0.55);
    }
    Rectangle {
        width: 7px;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        width: 7px;
        border-radius: 2px;
        background: Theme.accent.with-alpha(0.55);
    }
}

component StatusPill inherits Rectangle {
    height: 30px;
    width: row.preferred-width;
    border-radius: 15px;
    background: Bridge.recording ? Theme.recording : Theme.surface-raised;
    border-width: Bridge.recording ? 0 : 1px;
    border-color: Theme.border;

    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 8px;
        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: Bridge.recording ? #ffffff : Theme.ok;
        }
        Text {
            text: Bridge.recording ? @tr("ENREGISTREMENT  {}", Bridge.elapsed) : @tr("Prêt");
            color: Bridge.recording ? #ffffff : Theme.text;
            font-weight: 700;
            font-size: Theme.font-normal;
            vertical-alignment: center;
        }
    }
}

// Nouvelle version : clic pour l'installer ; avancement du téléchargement
// en fond.
component UpdatePill inherits Rectangle {
    height: 30px;
    width: row.preferred-width;
    border-radius: 15px;
    background: touch.has-hover ? Theme.accent.with-alpha(0.3) : Theme.accent.with-alpha(0.18);
    border-width: 1px;
    border-color: Theme.accent.with-alpha(0.6);
    clip: true;
    accessible-role: button;
    accessible-label: Bridge.update-text;

    if Bridge.update-state == "downloading": Rectangle {
        x: 0;
        width: parent.width * Bridge.update-progress;
        background: Theme.accent.with-alpha(0.3);
        animate width { duration: 240ms; }
    }
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 8px;
        Image {
            source: @image-url("icons/up.svg");
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.accent;
        }
        Text {
            text: Bridge.update-text;
            color: Theme.text;
            font-size: Theme.font-small;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Bridge.install-update();
        }
    }
}

// Programmation : prochain créneau, ou fin prévue de l'enregistrement
// programmé ; « Programmer » s'il n'y en a pas. Clic : les programmations.
component SchedulePill inherits Rectangle {
    property <bool> planned: Bridge.schedule-text != "";

    height: 30px;
    width: row.preferred-width;
    border-radius: 15px;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface-raised;
    border-width: 1px;
    border-color: Bridge.schedule-running ? Theme.recording.with-alpha(0.6)
        : root.planned ? Theme.accent.with-alpha(0.5) : Theme.border;
    accessible-role: button;
    accessible-label: root.planned ? @tr("Programmations : {}", Bridge.schedule-text) : @tr("Programmer des enregistrements");

    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 8px;
        Image {
            source: @image-url("icons/clock.svg");
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: Bridge.schedule-running ? Theme.recording : root.planned ? Theme.accent : Theme.text-muted;
        }
        Text {
            text: root.planned ? Bridge.schedule-text : @tr("Programmer");
            color: root.planned ? Theme.text : Theme.text-muted;
            font-size: Theme.font-small;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Bridge.open-schedules();
        }
    }
}

// Micro activé : son état et son niveau pendant l'enregistrement.
component MicPill inherits Rectangle {
    height: 30px;
    width: row.preferred-width;
    border-radius: 15px;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Bridge.mic-tone >= 2 ? Theme.tone-color(Bridge.mic-tone).with-alpha(0.6) : Theme.border;
    accessible-role: text;
    accessible-label: Bridge.mic-text;

    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 8px;
        Image {
            source: @image-url("icons/mic.svg");
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: Bridge.mic-recording && Bridge.mic-sound ? Theme.ok : Theme.tone-color(Bridge.mic-tone);
        }
        Text {
            text: Bridge.mic-text;
            color: Theme.text;
            font-size: Theme.font-small;
            font-weight: 600;
            vertical-alignment: center;
        }
        if Bridge.mic-recording: LevelMeter {
            width: 44px;
            y: (parent.height - self.height) / 2;
            level: Bridge.mic-level;
            active: Bridge.mic-sound;
        }
    }
}

// Conversion MP4 en cours : avancement en fond, clic pour annuler.
component ConversionPill inherits Rectangle {
    height: 30px;
    width: row.preferred-width;
    border-radius: 15px;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.accent.with-alpha(0.5);
    clip: true;
    accessible-role: button;
    accessible-label: @tr("{}. Cliquer pour annuler la conversion.", Bridge.conversion-text);

    Rectangle {
        x: 0;
        width: parent.width * Bridge.conversion-progress;
        background: Theme.accent.with-alpha(0.25);
        animate width { duration: 240ms; }
    }
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 8px;
        Image {
            source: @image-url("icons/convert.svg");
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.accent;
        }
        Text {
            text: Bridge.conversion-text;
            color: Theme.text;
            font-size: Theme.font-small;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Bridge.request-cancel-conversion();
        }
    }
}

component TopBar inherits HorizontalLayout {
    spacing: 14px;
    height: 36px;
    Logo {
        y: (parent.height - self.height) / 2;
    }
    Text {
        text: "Polyptyque";
        color: Theme.text;
        font-size: 17px;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        text: Bridge.scene-name;
        color: Theme.text-muted;
        vertical-alignment: center;
        overflow: elide;
        min-width: 60px;
    }
    Rectangle {
        horizontal-stretch: 1;
    }
    // Les informations s'abrègent d'elles-mêmes si la fenêtre est étroite.
    Text {
        text: Bridge.encoder-text;
        color: Theme.text-faint;
        font-size: Theme.font-small;
        vertical-alignment: center;
        overflow: elide;
        min-width: 0;
    }
    Text {
        text: Bridge.disk-text;
        color: Bridge.disk-warning ? Theme.warning : Theme.text-muted;
        font-size: Theme.font-small;
        vertical-alignment: center;
        overflow: elide;
        min-width: 0;
    }
    if Bridge.update-state != "": UpdatePill {
        y: (parent.height - self.height) / 2;
    }
    SchedulePill {
        y: (parent.height - self.height) / 2;
    }
    if Bridge.mic-enabled || Bridge.mic-recording: MicPill {
        y: (parent.height - self.height) / 2;
    }
    if Bridge.converting: ConversionPill {
        y: (parent.height - self.height) / 2;
    }
    StatusPill { }
}

// Grille des aperçus : choisit le nombre de colonnes qui donne les plus
// grandes cartes possibles en 16:9, puis centre l'ensemble.
component PreviewGrid inherits Rectangle {
    property <int> count: Bridge.cards.length;
    property <length> spacing: Theme.gap;
    // Hauteur de la barre d'informations sous chaque aperçu.
    property <length> info-height: 50px;

    pure function rows-for(columns: int) -> int {
        return Math.ceil(self.count / columns);
    }
    pure function width-for(columns: int) -> length {
        return min(
            (self.width - self.spacing * (columns - 1)) / columns,
            ((self.height - self.spacing * (self.rows-for(columns) - 1)) / self.rows-for(columns) - self.info-height) * 16 / 9);
    }

    property <int> best-2: count >= 2 && self.width-for(2) > self.width-for(1) ? 2 : 1;
    property <int> best-3: count >= 3 && self.width-for(3) > self.width-for(best-2) ? 3 : best-2;
    property <int> columns: count >= 4 && self.width-for(4) > self.width-for(best-3) ? 4 : best-3;
    property <int> rows: self.rows-for(columns);
    property <length> cell-width: max(self.width-for(columns), 120px);
    property <length> cell-height: cell-width * 9 / 16 + info-height;
    property <length> offset-x: (self.width - columns * cell-width - (columns - 1) * spacing) / 2;
    property <length> offset-y: (self.height - rows * cell-height - (rows - 1) * spacing) / 2;

    init => {
        Bridge.card-width = self.cell-width;
    }
    changed cell-width => {
        Bridge.card-width = self.cell-width;
    }

    // Glisser-déposer d'une carte : carte déplacée (-1 : aucune), pointeur
    // dans la grille et point de la carte attrapé, emplacement d'arrivée.
    property <int> drag-from: -1;
    property <length> drag-x;
    property <length> drag-y;
    property <length> grab-x;
    property <length> grab-y;
    property <bool> drag-inside: drag-from >= 0 && drag-x >= 0 && drag-x <= self.width && drag-y >= 0 && drag-y <= self.height;
    property <int> drag-column: max(0, min(columns - 1, Math.floor((drag-x - offset-x + spacing / 2) / (cell-width + spacing))));
    property <int> drag-row: max(0, min(rows - 1, Math.floor((drag-y - offset-y + spacing / 2) / (cell-height + spacing))));
    property <int> drag-to: min(count - 1, drag-row * columns + drag-column);

    if count == 0: Rectangle {
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            alignment: center;
            spacing: 16px;
            Text {
                text: @tr("Aucune source dans cette scène");
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: @tr("Ajouter un navigateur (son isolé grâce à un profil dédié) ou n'importe quelle application.");
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                ActionButton {
                    text: @tr("Navigateur");
                    icon: @image-url("icons/globe.svg");
                    has-icon: true;
                    kind: "primary";
                    clicked => {
                        Bridge.request-add-browser();
                    }
                }
                ActionButton {
                    text: @tr("Application");
                    icon: @image-url("icons/window.svg");
                    has-icon: true;
                    clicked => {
                        Bridge.request-add-application();
                    }
                }
            }
        }
    }

    for card[index] in Bridge.cards: SourceCardView {
        x: offset-x + Math.mod(index, columns) * (cell-width + spacing);
        y: offset-y + Math.floor(index / columns) * (cell-height + spacing);
        width: cell-width;
        height: cell-height;
        card: card;
        draggable: !Bridge.recording && root.count > 1;
        lifted: index == root.drag-from;
        open-window => {
            Bridge.open-source(card.id);
        }
        restore-window => {
            Bridge.restore-window(card.id);
        }
        toggle-recording => {
            Bridge.toggle-source(card.id);
        }
        drag-moved(dx, dy, x, y) => {
            root.drag-from = index;
            root.drag-x = self.x + x;
            root.drag-y = self.y + y;
            root.grab-x = x - dx;
            root.grab-y = y - dy;
        }
        drag-ended => {
            if root.drag-inside {
                Bridge.move-source-to(root.drag-from, root.drag-to);
            }
            root.drag-from = -1;
        }
        drag-cancelled => {
            root.drag-from = -1;
        }
    }

    // Emplacement où la carte arrivera si elle est lâchée ici.
    if drag-from >= 0 && drag-inside && drag-to != drag-from: Rectangle {
        x: offset-x + Math.mod(drag-to, columns) * (cell-width + spacing);
        y: offset-y + Math.floor(drag-to / columns) * (cell-height + spacing);
        width: cell-width;
        height: cell-height;
        border-radius: Theme.radius;
        border-width: 2px;
        border-color: Theme.accent;
        background: Theme.accent.with-alpha(0.08);
    }

    // La carte déplacée, en réduit, sous le pointeur.
    if drag-from >= 0: Rectangle {
        width: cell-width / 2;
        height: cell-height / 2;
        x: drag-x - grab-x / 2;
        y: drag-y - grab-y / 2;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.accent;
        background: Theme.surface;
        clip: true;
        opacity: 0.9;
        VerticalLayout {
            Rectangle {
                vertical-stretch: 1;
                background: Theme.preview-background;
                Image {
                    source: Bridge.cards[root.drag-from].preview;
                    width: parent.width;
                    height: parent.height;
                    image-fit: contain;
                }
            }
            Text {
                text: Bridge.cards[root.drag-from].name;
                color: Theme.text;
                font-weight: 600;
                overflow: elide;
                height: 26px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}

component ScenesPanel inherits Panel {
    title: @tr("SCÈNES");
    ListView {
        vertical-stretch: 1;
        for scene in Bridge.scenes: ListRow {
            text: scene.name;
            detail: scene.count + "";
            selected: scene.active;
            enabled: !Bridge.recording;
            clicked => {
                Bridge.select-scene(scene.id);
            }
        }
    }
    HorizontalLayout {
        spacing: 2px;
        IconButton {
            icon: @image-url("icons/plus.svg");
            label: @tr("Nouvelle scène");
            enabled: !Bridge.recording;
            clicked => {
                Bridge.request-new-scene();
            }
        }
        IconButton {
            icon: @image-url("icons/edit.svg");
            label: @tr("Renommer la scène");
            enabled: !Bridge.recording;
            clicked => {
                Bridge.request-rename-scene();
            }
        }
        IconButton {
            icon: @image-url("icons/duplicate.svg");
            label: @tr("Dupliquer la scène");
            enabled: !Bridge.recording;
            clicked => {
                Bridge.request-duplicate-scene();
            }
        }
        IconButton {
            icon: @image-url("icons/trash.svg");
            label: @tr("Supprimer la scène");
            enabled: !Bridge.recording && Bridge.scenes.length > 1;
            clicked => {
                Bridge.request-delete-scene();
            }
        }
        Rectangle { }
    }
}

// Ligne de la liste des sources, avec son menu (clic droit) et le
// glisser-déposer.
component SourceRow inherits Rectangle {
    in property <SourceItem> source;
    in property <int> index;
    in property <bool> draggable;
    // Ligne en cours de déplacement, atténuée à sa place.
    in property <bool> lifted;
    // Trait d'arrivée : 0 aucun, 1 au-dessus, 2 au-dessous.
    in property <int> drop-line;
    callback drag-moved(length, length, length, length);
    callback drag-ended();
    callback drag-cancelled();

    height: 38px;

    menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: @tr("Copier (Ctrl+C)");
                activated => {
                    Bridge.copy-source();
                }
            }
            MenuItem {
                title: @tr("Coller (Ctrl+V)");
                enabled: Bridge.can-paste && !Bridge.recording;
                activated => {
                    Bridge.paste-source();
                }
            }
        }
    }
    // Au-dessus du menu : la ligne reçoit aussi le clic droit, qui la
    // sélectionne avant d'ouvrir le menu.
    ListRow {
        width: parent.width;
        opacity: root.lifted ? 0.4 : 1;
        text: root.source.name;
        detail: root.source.kind;
        icon: root.source.browser ? @image-url("icons/globe.svg") : @image-url("icons/window.svg");
        has-icon: true;
        selected: root.index == Bridge.selected-source;
        draggable: root.draggable;
        clicked => {
            Bridge.selected-source = root.index;
        }
        right-clicked(x, y) => {
            Bridge.selected-source = root.index;
            menu.show({ x: x, y: y });
        }
        drag-moved(dx, dy, x, y) => {
            root.drag-moved(dx, dy, x, y);
        }
        drag-ended => {
            root.drag-ended();
        }
        drag-cancelled => {
            root.drag-cancelled();
        }
    }
    if root.drop-line != 0: Rectangle {
        y: root.drop-line == 1 ? 0 : parent.height - self.height;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
    }
}

component SourcesPanel inherits Panel {
    title: @tr("SOURCES");

    // Glisser-déposer d'une ligne : ligne déplacée (-1 : aucune), pointeur
    // dans la liste, rang d'arrivée.
    property <int> drag-from: -1;
    property <length> drag-x;
    property <length> drag-y;
    property <bool> drag-inside: drag-from >= 0 && drag-x >= 0 && drag-x <= list-area.width && drag-y >= 0 && drag-y <= list-area.height;
    property <int> drag-to: max(0, min(Bridge.sources.length - 1, Math.floor((drag-y - list.content-y) / 38px)));

    list-area := Rectangle {
        vertical-stretch: 1;
        // Clic droit dans le vide de la liste : coller.
        ContextMenuArea {
            Menu {
                MenuItem {
                    title: @tr("Coller (Ctrl+V)");
                    enabled: Bridge.can-paste && !Bridge.recording;
                    activated => {
                        Bridge.paste-source();
                    }
                }
            }
        }
        list := ListView {
            width: parent.width;
            height: parent.height;
            for source[index] in Bridge.sources: SourceRow {
                source: source;
                index: index;
                draggable: !Bridge.recording && Bridge.sources.length > 1;
                lifted: index == root.drag-from;
                drop-line: !root.drag-inside || index != root.drag-to || root.drag-to == root.drag-from ? 0
                    : root.drag-to < root.drag-from ? 1 : 2;
                drag-moved(dx, dy, x, y) => {
                    root.drag-from = index;
                    root.drag-x = self.absolute-position.x + x - list-area.absolute-position.x;
                    root.drag-y = self.absolute-position.y + y - list-area.absolute-position.y;
                }
                drag-ended => {
                    if root.drag-inside {
                        Bridge.move-source-to(root.drag-from, root.drag-to);
                    }
                    root.drag-from = -1;
                }
                drag-cancelled => {
                    root.drag-from = -1;
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        ActionButton {
            text: @tr("Navigateur");
            icon: @image-url("icons/plus.svg");
            has-icon: true;
            enabled: !Bridge.recording;
            clicked => {
                Bridge.request-add-browser();
            }
        }
        ActionButton {
            text: @tr("Application");
            icon: @image-url("icons/plus.svg");
            has-icon: true;
            enabled: !Bridge.recording;
            clicked => {
                Bridge.request-add-application();
            }
        }
        ActionButton {
            text: @tr("Ouvrir les fenêtres");
            icon: @image-url("icons/launch.svg");
            has-icon: true;
            kind: "ghost";
            enabled: Bridge.sources.length > 0;
            clicked => {
                Bridge.open-scene-windows();
            }
        }
        Rectangle { }
        IconButton {
            icon: @image-url("icons/up.svg");
            label: @tr("Monter la source");
            enabled: !Bridge.recording && Bridge.selected-source > 0;
            clicked => {
                Bridge.move-source(-1);
            }
        }
        IconButton {
            icon: @image-url("icons/down.svg");
            label: @tr("Descendre la source");
            enabled: !Bridge.recording && Bridge.selected-source >= 0 && Bridge.selected-source < Bridge.sources.length - 1;
            clicked => {
                Bridge.move-source(1);
            }
        }
        IconButton {
            icon: @image-url("icons/trash.svg");
            label: @tr("Supprimer la source");
            enabled: !Bridge.recording && Bridge.selected-source >= 0;
            clicked => {
                Bridge.request-remove-source();
            }
        }
    }
}

component RecordButton inherits Rectangle {
    height: 58px;
    border-radius: Theme.radius;
    background: Bridge.recording ? (touch.has-hover ? Theme.surface-hover : Theme.surface-raised) : (touch.has-hover ? Theme.recording-hover : Theme.recording);
    border-width: Bridge.recording ? 1px : 0;
    border-color: Theme.recording;
    accessible-role: button;
    accessible-label: Bridge.recording ? @tr("Arrêter toutes les sources") : @tr("Démarrer l'enregistrement de toutes les sources");
    animate background { duration: 120ms; }

    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        Image {
            source: Bridge.recording ? @image-url("icons/stop.svg") : @image-url("icons/record.svg");
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            colorize: Bridge.recording ? Theme.recording : #ffffff;
        }
        Text {
            text: Bridge.recording ? @tr("Tout arrêter") : @tr("Démarrer l'enregistrement");
            color: #ffffff;
            font-size: Theme.font-title;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Bridge.start-stop();
        }
    }
}

component ControlsPanel inherits Panel {
    title: @tr("COMMANDES");
    RecordButton { }
    HorizontalLayout {
        spacing: 8px;
        ActionButton {
            text: @tr("Réglages");
            icon: @image-url("icons/settings.svg");
            has-icon: true;
            horizontal-stretch: 1;
            enabled: !Bridge.recording;
            clicked => {
                Bridge.open-settings();
            }
        }
        ActionButton {
            text: @tr("Fichiers");
            icon: @image-url("icons/folder.svg");
            has-icon: true;
            horizontal-stretch: 1;
            clicked => {
                Bridge.open-output-folder();
            }
        }
    }
    ActionButton {
        text: @tr("Convertir en MP4…");
        icon: @image-url("icons/convert.svg");
        has-icon: true;
        clicked => {
            Bridge.convert-files();
        }
    }
    Toggle {
        text: @tr("Aperçus en direct");
        checked: Bridge.previews-enabled;
        toggled(value) => {
            Bridge.toggle-previews();
        }
    }
    Rectangle {
        vertical-stretch: 1;
    }
}

export component AppWindow inherits Window {
    title: Bridge.recording ? "● \{Bridge.elapsed} · Polyptyque" : "Polyptyque";
    icon: @image-url("icons/polyptyque.png");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 980px;
    min-height: 640px;
    background: Theme.background;
    default-font-size: Theme.font-normal;
    forward-focus: shortcuts;

    // Plus aucune fenêtre modale : les raccourcis de la fenêtre principale
    // reprennent la main, sans avoir à recliquer.
    property <bool> modal-open: Bridge.sheet != "" || Bridge.prompt-kind != "";
    changed modal-open => {
        if !self.modal-open {
            shortcuts.focus();
        }
    }

    // Raccourcis de la fenêtre principale, hors fenêtres modales (leurs
    // champs de texte gardent leur propre Ctrl+C / Ctrl+V).
    shortcuts := FocusScope {
        KeyBinding {
            keys: @keys(Control + C);
            activated => {
                Bridge.copy-source();
            }
        }
        KeyBinding {
            keys: @keys(Control + V);
            activated => {
                Bridge.paste-source();
            }
        }

        VerticalLayout {
            padding: 16px;
            spacing: Theme.gap;
            TopBar { }
            PreviewGrid {
                vertical-stretch: 1;
            }
            HorizontalLayout {
                height: 236px;
                spacing: Theme.gap;
                ScenesPanel {
                    width: 230px;
                }
                SourcesPanel {
                    horizontal-stretch: 1;
                }
                ControlsPanel {
                    width: 300px;
                }
            }
        }
    }

    if Bridge.sheet == "browser": AddBrowserSheet {
        width: root.width;
        height: root.height;
    }
    if Bridge.sheet == "application": AddApplicationSheet {
        width: root.width;
        height: root.height;
    }
    if Bridge.sheet == "settings": SettingsSheet {
        width: root.width;
        height: root.height;
    }
    if Bridge.sheet == "scene-new" || Bridge.sheet == "scene-rename" || Bridge.sheet == "scene-duplicate": SceneNameSheet {
        width: root.width;
        height: root.height;
    }
    if Bridge.sheet == "incident": IncidentSheet {
        width: root.width;
        height: root.height;
    }
    if Bridge.sheet == "report": ReportSheet {
        width: root.width;
        height: root.height;
    }
    if Bridge.sheet == "schedules": SchedulesSheet {
        width: root.width;
        height: root.height;
    }
    if Bridge.sheet == "schedule-new" || Bridge.sheet == "schedule-edit": ScheduleEditorSheet {
        width: root.width;
        height: root.height;
    }
    if Bridge.sheet == "confirm": ConfirmSheet {
        width: root.width;
        height: root.height;
    }
    // Question de la programmation : au-dessus des autres fenêtres modales,
    // pour qu'un compte à rebours ne reste jamais caché.
    if Bridge.prompt-kind != "": SchedulePrompt {
        width: root.width;
        height: root.height;
    }
    // Les messages restent visibles au-dessus des fenêtres modales.
    if Bridge.toast-text != "": Toast {
        x: (root.width - self.width) / 2;
        y: Bridge.sheet == "" && Bridge.prompt-kind == "" ? root.height - self.height - 262px : root.height - self.height - 24px;
    }
    if Bridge.busy-text != "": BusyOverlay {
        width: root.width;
        height: root.height;
    }
}
