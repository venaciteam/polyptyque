// Seul lien entre l'interface et le reste du logiciel : des données à
// afficher et des actions à déclencher. Une autre interface pourrait
// remplacer celle-ci en utilisant exactement le même « pont ».

export struct SceneItem {
    id: string,
    name: string,
    count: int,
    active: bool,
}

export struct SourceItem {
    id: string,
    name: string,
    kind: string,
    browser: bool,
}

export struct SourceCard {
    id: string,
    name: string,
    kind: string,
    state: string,
    // 0 neutre, 1 bon, 2 attention, 3 erreur
    tone: int,
    preview: image,
    has-preview: bool,
    placeholder: string,
    level: float,
    sound: bool,
    size: string,
    dropped: int,
    warning: string,
    can-open: bool,
    // Fenêtre réduite : bouton « Rétablir la fenêtre ».
    can-restore: bool,
    // Cette source enregistre.
    recording: bool,
    // Démarrage ou finalisation en cours : bouton d'enregistrement inactif.
    busy: bool,
}

// Fichier d'un enregistrement interrompu, dans le bilan.
export struct IncidentFile {
    name: string,
    detail: string,
}

// Programmation, dans la liste des programmations.
export struct ScheduleItem {
    id: string,
    scene: string,
    // « 21:00 → 22:00 », « 22:00 → 02:00 (lendemain) ».
    times: string,
    // « Tous les jours », « Une fois, le dim. 25 oct. »…
    repeat: string,
    // « Prochain : aujourd'hui à 21:00 », « Désactivée »…
    next: string,
    enabled: bool,
    // Son enregistrement est en cours : ni modifiable ni supprimable.
    locked: bool,
}

export struct WindowItem {
    title: string,
    program: string,
    browser: bool,
}

export global Bridge {
    // État général.
    in property <bool> recording;
    in property <string> elapsed: "00:00:00";
    in property <string> disk-text;
    in property <bool> disk-warning;
    in property <string> encoder-text;
    in property <string> busy-text;
    in property <string> toast-text;
    in property <int> toast-tone;
    in property <bool> previews-enabled: true;
    in property <string> version;

    // Micro (fichier séparé) : activé dans les réglages, et son état
    // pendant l'enregistrement.
    in property <bool> mic-enabled;
    in property <bool> mic-recording;
    in property <string> mic-text: @tr("Micro");
    in property <int> mic-tone;
    in property <float> mic-level;
    in property <bool> mic-sound;

    // Mise à jour : "" (aucune), "available", "downloading", "ready".
    in property <string> update-state;
    in property <string> update-text;
    in property <float> update-progress;

    // Conversion MP4 en cours.
    in property <bool> converting;
    in property <string> conversion-text;
    in property <float> conversion-progress;

    // Scènes et sources de la scène active.
    in property <[SceneItem]> scenes;
    in property <string> scene-name;
    in property <[SourceItem]> sources;
    in property <[SourceCard]> cards;
    // Largeur d'une carte d'aperçu à l'écran (sert à choisir la définition
    // des aperçus).
    in-out property <length> card-width;
    in-out property <int> selected-source: -1;
    // Une source a été copiée (Ctrl+C) et existe encore : elle peut être
    // collée dans la scène en cours.
    in property <bool> can-paste;

    // Feuille ouverte : "", "browser", "application", "settings",
    // "scene-new", "scene-rename", "scene-duplicate", "confirm", "incident", "schedules",
    // "schedule-new", "schedule-edit".
    in-out property <string> sheet;

    // Programmation : pastille de la barre du haut (vide : aucune
    // programmation à venir) ; vrai pendant un enregistrement programmé.
    in property <string> schedule-text;
    in property <bool> schedule-running;
    // Liste des programmations.
    in property <[ScheduleItem]> schedules;
    // Lancement au démarrage de Windows (appliqué tout de suite), et ce qui
    // l'empêche éventuellement.
    in property <bool> startup-enabled;
    in property <string> startup-note;
    // Formulaire d'une programmation.
    in property <[string]> schedule-scene-choices;
    in-out property <int> schedule-scene-index;
    in-out property <string> schedule-start;
    in-out property <string> schedule-end;
    in property <string> schedule-times-note;
    // Répétition : 0 une seule fois, 1 tous les jours, 2 certains jours.
    in-out property <int> schedule-repeat-index;
    // Date d'une programmation « une seule fois » : jour, mois (en toutes
    // lettres) et année, chacun dans sa liste ; jour de la semaine rappelé.
    in property <[string]> schedule-day-choices;
    in-out property <int> schedule-day-index;
    in property <[string]> schedule-month-choices;
    in-out property <int> schedule-month-index;
    in property <[string]> schedule-year-choices;
    in-out property <int> schedule-year-index;
    in property <string> schedule-date-note;
    // Jours cochés, du lundi au dimanche.
    in property <[bool]> schedule-days;
    in property <string> schedule-error;

    // Question posée par la programmation, au-dessus de tout : "" (aucune),
    // "missed" (démarrage manqué), "auto-stop" (lancement à la main pendant
    // un créneau), "info".
    in property <string> prompt-kind;
    in property <string> prompt-title;
    in property <string> prompt-text;
    in property <string> prompt-countdown;
    in property <string> prompt-accept;
    // Vide : un seul bouton.
    in property <string> prompt-decline;

    // Ajout d'une source navigateur.
    in property <[string]> browser-choices;
    in-out property <int> browser-index;
    in-out property <string> browser-path;
    in-out property <string> new-name;
    in-out property <string> new-url;
    in-out property <bool> open-now: true;

    // Ajout d'une source application.
    in property <[WindowItem]> windows;
    in-out property <int> window-index: -1;
    in-out property <bool> relaunch;
    in-out property <bool> capture-cursor: true;

    // Scène : nom saisi.
    in-out property <string> scene-name-input;

    // Confirmation.
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-button;
    // Action destructrice (bouton rouge) ou non.
    in property <bool> confirm-danger: true;

    // Fermeture de la fenêtre alors qu'une programmation est prévue :
    // arrière-plan ou quitter, choix retenu si la case est cochée.
    in property <string> close-text;
    in-out property <bool> close-remember;

    // Réglages.
    in property <[string]> resolution-choices;
    in-out property <int> resolution-index;
    in property <[string]> fps-choices;
    in-out property <int> fps-index;
    in-out property <string> bitrate-text;
    in property <[string]> codec-choices;
    in-out property <int> codec-index;
    in property <[string]> hardware-choices;
    in-out property <int> hardware-index;
    in property <[string]> audio-choices;
    in-out property <int> audio-index;
    in-out property <string> output-dir;
    in-out property <string> template;
    in-out property <bool> settings-previews;
    in-out property <bool> settings-convert;
    // Mises à jour : 0 versions stables, 1 stables et bêta, 2 ne pas rechercher.
    in-out property <int> settings-update-index;
    // Langue : 0 automatique, 1 français, 2 anglais. Horloge : 0 automatique,
    // 1 24 h, 2 12 h.
    in-out property <int> settings-language-index;
    in-out property <int> settings-clock-index;
    // Horloge en vigueur (exemples d'heures dans la programmation).
    in property <bool> twelve-hour;
    // Mois avant le jour dans une date (anglais : « October 25, 2026 »).
    in property <bool> month-first;
    in-out property <bool> settings-open-windows;
    in-out property <bool> settings-close-browsers;
    in-out property <bool> settings-startup;
    // Fermeture avec une programmation prévue : 0 demander, 1 arrière-plan,
    // 2 quitter.
    in-out property <int> settings-close-index;
    in-out property <bool> settings-mic;
    in property <[string]> mic-choices;
    in-out property <int> mic-index;
    // Test du micro choisi, pendant que les réglages sont ouverts.
    in property <float> mic-test-level;
    in property <bool> mic-test-sound;
    in property <string> mic-test-error;
    in property <[string]> hotkey-choices;
    in-out property <int> hotkey-record-index;
    in-out property <int> hotkey-show-index;
    in-out property <int> hotkey-previews-index;
    in property <bool> can-browse;
    in property <string> settings-error;

    // Actions.
    callback start-stop();
    callback select-scene(string);
    callback request-new-scene();
    callback request-rename-scene();
    callback request-duplicate-scene();
    callback request-delete-scene();
    callback confirm-scene-name();
    callback request-add-browser();
    callback confirm-add-browser();
    callback request-add-application();
    callback refresh-windows();
    callback window-selected(int);
    callback confirm-add-application();
    callback request-remove-source();
    callback move-source(int);
    // Glisser-déposer : la source passe de la première position à la
    // seconde (les autres se décalent).
    callback move-source-to(int, int);
    // Copie la source sélectionnée ; colle la source copiée dans la scène en
    // cours (la même source, partagée entre les scènes).
    callback copy-source();
    callback paste-source();
    callback open-source(string);
    callback restore-window(string);
    callback open-scene-windows();

    // Enregistrement interrompu (plantage, coupure de courant) : bilan au
    // lancement suivant.
    in property <string> incident-text;
    in property <[IncidentFile]> incident-files;
    in property <bool> incident-can-repair;
    in property <bool> incident-can-resume;
    callback incident-repair();
    callback incident-resume();
    // Signalement d'un problème : chemin du rapport une fois préparé (vide
    // avant).
    in property <string> report-path;
    in property <string> report-name;
    callback request-report(bool);
    callback prepare-report();
    callback open-report();
    callback open-report-page();
    // Démarre ou arrête l'enregistrement d'une seule source.
    callback toggle-source(string);
    callback open-settings();
    callback browse-output();
    callback save-settings();
    callback open-output-folder();
    callback toggle-previews();
    callback convert-files();
    callback install-update();
    callback open-mic-privacy();
    callback request-cancel-conversion();
    callback close-sheet();
    callback confirm-accepted();
    callback close-to-background();
    callback close-anyway();
    callback dismiss-toast();

    // Programmation.
    callback open-schedules();
    // Identifiant vide : nouvelle programmation.
    callback edit-schedule(string);
    callback toggle-schedule(string, bool);
    callback delete-schedule(string);
    callback save-schedule();
    callback schedule-times-edited();
    callback schedule-date-edited();
    callback toggle-schedule-day(int);
    callback close-schedule-editor();
    callback set-launch-at-startup(bool);
    callback prompt-accepted();
    callback prompt-declined();
}
