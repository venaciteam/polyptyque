// Composants visuels réutilisables.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SourceCard } from "bridge.slint";

// Bouton avec texte et icône facultative.
// Genres : "primary", "secondary", "danger", "ghost".
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <string> kind: "secondary";
    in property <bool> enabled: true;
    callback clicked;

    height: 34px;
    border-radius: Theme.radius-small;
    border-width: root.kind == "secondary" ? 1px : 0px;
    border-color: Theme.border;
    opacity: root.enabled ? 1 : 0.4;
    background: root.kind == "primary" ? (touch.has-hover && root.enabled ? Theme.accent-hover : Theme.accent)
        : root.kind == "danger" ? (touch.has-hover && root.enabled ? Theme.recording-hover : Theme.recording)
        : root.kind == "ghost" ? (touch.has-hover && root.enabled ? Theme.surface-hover : transparent)
        : (touch.has-hover && root.enabled ? Theme.surface-hover : Theme.surface-raised);
    accessible-role: button;
    accessible-label: root.text;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: center;
        if root.has-icon: Image {
            source: root.icon;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            colorize: label.color;
        }
        label := Text {
            text: root.text;
            color: root.kind == "primary" || root.kind == "danger" ? #ffffff : Theme.text;
            font-size: Theme.font-normal;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// Petit bouton carré avec une icône.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: 30px;
    height: 30px;
    border-radius: Theme.radius-small;
    background: touch.has-hover && root.enabled ? Theme.surface-hover : transparent;
    opacity: root.enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: root.label;
    animate background { duration: 120ms; }

    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        colorize: Theme.text-muted;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// Pastille d'état : point coloré et texte.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <int> tone;

    height: 22px;
    width: row.preferred-width;
    border-radius: 11px;
    background: #000000a0;

    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;
        Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            border-radius: 3.5px;
            background: Theme.tone-color(root.tone);
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-small;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Indicateur de niveau sonore (0 à 1).
export component LevelMeter inherits Rectangle {
    in property <float> level;
    in property <bool> active;

    height: 6px;
    border-radius: 3px;
    background: Theme.surface-hover;
    clip: true;

    Rectangle {
        x: 0;
        width: parent.width * clamp(root.level, 0, 1);
        height: parent.height;
        border-radius: 3px;
        background: @linear-gradient(90deg, Theme.ok 0%, Theme.ok 65%, Theme.warning 85%, Theme.recording 100%);
        animate width { duration: 90ms; }
    }
}

// Cadre de panneau avec titre.
export component Panel inherits Rectangle {
    in property <string> title;

    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        Text {
            text: root.title;
            color: Theme.text-faint;
            font-size: Theme.font-small;
            font-weight: 700;
            letter-spacing: 0.8px;
        }
        @children
    }
}

// Zone cliquable qui sait aussi glisser : bouton enfoncé, au-delà d'un
// petit déplacement, le clic devient un glisser (le clic n'est alors pas
// envoyé). Sous les boutons d'une carte, elle ne reçoit jamais leurs clics.
export component DragDetector inherits TouchArea {
    // Glisser permis (sinon : simple zone cliquable).
    in property <bool> draggable;
    // Déplacement avant de démarrer un glisser.
    in property <length> threshold: 8px;
    out property <bool> dragging;
    callback click();
    // Clic droit, à cette position dans la zone.
    callback right-press(length, length);
    // Déplacement depuis l'appui, puis position du pointeur dans la zone.
    callback drag-moved(length, length, length, length);
    callback drag-ended();
    // Bouton relâché hors de portée (fenêtre quittée…) : rien à déposer.
    callback drag-cancelled();

    clicked => {
        if !self.dragging {
            root.click();
        }
    }
    moved => {
        if !self.dragging && root.draggable
            && (abs(self.mouse-x - self.pressed-x) > root.threshold || abs(self.mouse-y - self.pressed-y) > root.threshold) {
            self.dragging = true;
        }
        if self.dragging {
            root.drag-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y, self.mouse-x, self.mouse-y);
        }
    }
    pointer-event(event) => {
        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
            root.right-press(self.mouse-x, self.mouse-y);
        }
        if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && self.dragging {
            self.dragging = false;
            root.drag-ended();
        }
    }
    changed pressed => {
        if !self.pressed && self.dragging {
            self.dragging = false;
            root.drag-cancelled();
        }
    }
}

// Ligne de liste sélectionnable.
export component ListRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked;
    // Clic droit, à cette position dans la ligne.
    callback right-clicked(length, length);
    // Glisser-déposer (voir `DragDetector`).
    in property <bool> draggable: false;
    out property <bool> dragging: touch.dragging;
    callback drag-moved(length, length, length, length);
    callback drag-ended();
    callback drag-cancelled();

    height: 38px;
    border-radius: Theme.radius-small;
    background: root.selected ? Theme.surface-hover : touch.has-hover && root.enabled ? Theme.surface-raised : transparent;
    accessible-role: list-item;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Rectangle {
            width: 3px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 1.5px;
            background: root.selected ? Theme.accent : transparent;
        }
        if root.has-icon: Image {
            source: root.icon;
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
            colorize: root.selected ? Theme.text : Theme.text-muted;
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.detail != "": Text {
            text: root.detail;
            color: Theme.text-faint;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := DragDetector {
        enabled: root.enabled;
        draggable: root.draggable;
        mouse-cursor: self.dragging ? grabbing : root.enabled ? pointer : default;
        click => {
            root.clicked();
        }
        right-press(x, y) => {
            root.right-clicked(x, y);
        }
        drag-moved(dx, dy, x, y) => {
            root.drag-moved(dx, dy, x, y);
        }
        drag-ended => {
            root.drag-ended();
        }
        drag-cancelled => {
            root.drag-cancelled();
        }
    }
}

// Bouton rond d'enregistrement d'une seule source : point rouge pour
// démarrer, carré pour arrêter.
component RecordToggle inherits Rectangle {
    in property <bool> recording;
    in property <bool> enabled: true;
    callback clicked;

    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: touch.has-hover && root.enabled ? Theme.surface-hover : Theme.surface-raised;
    border-width: 1px;
    border-color: root.recording ? Theme.recording.with-alpha(0.6) : Theme.border;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.recording ? @tr("Arrêter cette source") : @tr("Enregistrer cette source");
    animate background { duration: 120ms; }

    Image {
        source: root.recording ? @image-url("icons/stop.svg") : @image-url("icons/record.svg");
        width: 12px;
        height: 12px;
        colorize: Theme.recording;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// Carte d'une source : aperçu, état, son, taille du fichier.
export component SourceCardView inherits Rectangle {
    in property <SourceCard> card;
    // Glisser-déposer (voir `DragDetector`) ; `lifted` : carte en cours de
    // déplacement, atténuée à sa place.
    in property <bool> draggable;
    in property <bool> lifted;
    callback open-window();
    callback restore-window();
    callback toggle-recording();
    callback drag-moved(length, length, length, length);
    callback drag-ended();
    callback drag-cancelled();

    property <bool> recording: root.card.recording;

    border-radius: Theme.radius;
    background: Theme.surface;
    border-width: 1px;
    border-color: root.recording ? Theme.recording.with-alpha(0.55) : Theme.border;
    clip: true;
    opacity: root.lifted ? 0.4 : 1;

    // Sous le contenu : les boutons de la carte gardent leurs clics ; partout
    // ailleurs, appuyer puis déplacer déplace la carte.
    DragDetector {
        draggable: root.draggable;
        mouse-cursor: self.dragging ? grabbing : default;
        drag-moved(dx, dy, x, y) => {
            root.drag-moved(dx, dy, x, y);
        }
        drag-ended => {
            root.drag-ended();
        }
        drag-cancelled => {
            root.drag-cancelled();
        }
    }

    VerticalLayout {
        Rectangle {
            vertical-stretch: 1;
            background: Theme.preview-background;

            if root.card.has-preview: Image {
                source: root.card.preview;
                width: parent.width;
                height: parent.height;
                image-fit: contain;
            }

            if !root.card.has-preview: VerticalLayout {
                alignment: center;
                spacing: 10px;
                Text {
                    text: root.card.placeholder;
                    color: Theme.text-faint;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Fenêtre réduite ou perdue : de quoi la faire revenir, y compris
            // pendant l'enregistrement.
            if root.card.can-restore || root.card.can-open: HorizontalLayout {
                y: parent.height - 34px - 12px;
                height: 34px;
                alignment: center;
                ActionButton {
                    text: root.card.can-restore ? @tr("Rétablir la fenêtre")
                        : root.recording ? @tr("Rouvrir la fenêtre") : @tr("Ouvrir la fenêtre");
                    icon: root.card.can-restore ? @image-url("icons/restore.svg") : @image-url("icons/launch.svg");
                    has-icon: true;
                    clicked => {
                        if root.card.can-restore {
                            root.restore-window();
                        } else {
                            root.open-window();
                        }
                    }
                }
            }

            Badge {
                x: 10px;
                y: 10px;
                text: root.card.state;
                tone: root.card.tone;
            }

            if root.recording: Rectangle {
                x: parent.width - self.width - 10px;
                y: 10px;
                width: rec.preferred-width;
                height: 22px;
                border-radius: 11px;
                background: Theme.recording;
                rec := HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 5px;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3.5px;
                        background: #ffffff;
                    }
                    Text {
                        text: "REC";
                        color: #ffffff;
                        font-size: Theme.font-small;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            padding: 10px;
            padding-left: 12px;
            spacing: 12px;
            height: 50px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: root.card.name;
                    color: Theme.text;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.card.warning != "" ? root.card.warning : root.card.kind;
                    color: root.card.warning != "" ? Theme.warning : Theme.text-faint;
                    font-size: Theme.font-small;
                    overflow: elide;
                }
            }
            // Niveau sonore affiché en permanence : celui du moteur pendant
            // l'enregistrement, sinon celui de l'écoute de la carte.
            VerticalLayout {
                width: 90px;
                alignment: center;
                spacing: 5px;
                LevelMeter {
                    level: root.card.level;
                    active: root.card.sound;
                }
                Text {
                    text: root.card.sound ? @tr("Son actif") : @tr("Muet");
                    color: Theme.text-faint;
                    font-size: Theme.font-small;
                }
            }
            if root.recording: VerticalLayout {
                alignment: center;
                Text {
                    text: root.card.size;
                    color: Theme.text;
                    font-weight: 600;
                    horizontal-alignment: right;
                }
                Text {
                    text: @tr("{n} perdue" | "{n} perdues" % root.card.dropped);
                    color: root.card.dropped > 0 ? Theme.warning : Theme.text-faint;
                    font-size: Theme.font-small;
                    horizontal-alignment: right;
                }
            }
            RecordToggle {
                recording: root.recording;
                enabled: !root.card.busy;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.toggle-recording();
                }
            }
        }
    }
}

// Interrupteur aux couleurs du thème.
// L'état est fourni de l'extérieur : un clic demande le nouvel état par
// `toggled(valeur)` sans modifier `checked`, qui reste ainsi toujours lié à
// l'état réel.
export component Toggle inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback toggled(bool);

    height: 24px;
    min-width: row.min-width;
    accessible-role: switch;
    accessible-checked: root.checked;
    accessible-label: root.text;

    row := HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 36px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            background: root.checked ? Theme.accent : Theme.surface-hover;
            border-width: root.checked ? 0 : 1px;
            border-color: Theme.border;
            animate background { duration: 150ms; }
            Rectangle {
                width: 14px;
                height: 14px;
                x: root.checked ? parent.width - self.width - 3px : 3px;
                y: 3px;
                border-radius: 7px;
                background: #ffffff;
                animate x {
                    duration: 150ms;
                    easing: ease-out;
                }
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            vertical-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled(!root.checked);
        }
    }
}

// Libellé et aide autour d'un champ de formulaire.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;

    spacing: 6px;
    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: Theme.font-small;
        font-weight: 600;
    }
    @children
    if root.hint != "": Text {
        text: root.hint;
        color: Theme.text-faint;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }
}

// Encadré d'information.
export component Note inherits Rectangle {
    in property <string> text;
    in property <int> tone;

    background: Theme.tone-color(root.tone).with-alpha(0.08);
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: Theme.tone-color(root.tone).with-alpha(0.3);
    VerticalLayout {
        padding: 10px;
        Text {
            text: root.text;
            color: root.tone == 0 ? Theme.text-muted : Theme.tone-color(root.tone);
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
    }
}

// Fenêtre modale centrée, posée sur un fond assombri.
export component Sheet inherits Rectangle {
    in property <string> title;
    in property <length> sheet-width: 540px;
    // Hauteur disponible pour le contenu quand la fenêtre est à sa taille
    // maximale (marges, titre) : une fenêtre peut s'en servir pour ne faire
    // défiler qu'une partie de son contenu.
    out property <length> available-height: root.height - 40px - 2 * 22px - header.preferred-height - 16px;
    callback close();

    background: Theme.backdrop;

    // Bloque les clics vers l'interface derrière.
    TouchArea { }

    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: root.sheet-width;
            height: min(content.preferred-height, root.height - 40px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: Theme.surface;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 40px;
            drop-shadow-color: #00000090;

            content := VerticalLayout {
                padding: 22px;
                spacing: 16px;
                header := HorizontalLayout {
                    Text {
                        text: root.title;
                        color: Theme.text;
                        font-size: Theme.font-large;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        icon: @image-url("icons/close.svg");
                        label: @tr("Fermer");
                        clicked => {
                            root.close();
                        }
                    }
                }
                // Le contenu défile si la fenêtre est trop petite.
                scroll := ScrollView {
                    vertical-stretch: 1;
                    min-height: min(body.preferred-height, 120px);
                    preferred-height: body.preferred-height;
                    content-width: self.visible-width;
                    content-height: body.preferred-height;
                    body := VerticalLayout {
                        width: scroll.visible-width;
                        spacing: 16px;
                        @children
                    }
                }
            }
        }
    }

    init => {
        focus.focus();
    }
}

// Rangée de boutons en bas d'une fenêtre modale.
export component Footer inherits HorizontalLayout {
    spacing: 10px;
    alignment: end;
    padding-top: 6px;
    @children
}
