#: polyptyque-core/src/control/catalog.rs:100
msgid "Paramètre « {} » : {} attendu."
msgstr "Parameter “{}”: {} expected."

#: polyptyque-core/src/control/catalog.rs:108
msgid "Paramètre « {} » : « {} » n'est pas une valeur admise ({})."
msgstr "Parameter “{}”: “{}” isn’t an allowed value ({})."

#: polyptyque-core/src/control/catalog.rs:136
msgid "Les paramètres sont attendus sous forme d'objet."
msgstr "Parameters are expected as an object."

#: polyptyque-core/src/control/catalog.rs:141
msgid "Paramètre inconnu : « {}{} » (admis : {})."
msgstr "Unknown parameter: “{}{}” (allowed: {})."

#: polyptyque-core/src/control/catalog.rs:154
msgid "Paramètre obligatoire manquant : « {}{} »."
msgstr "Missing required parameter: “{}{}”."

#: polyptyque-core/src/control/catalog.rs:262
msgid "Source : son identifiant ou son nom."
msgstr "Source: its id or its name."

#: polyptyque-core/src/control/catalog.rs:269
msgid "true une fois la personne d'accord : sans lui, la commande renvoie « confirmation_required » avec le texte de la question à lui poser."
msgstr "true once the person agrees: without it, the command returns “confirmation_required” with the question to ask them."

#: polyptyque-core/src/control/catalog.rs:285
msgid "Dossier des enregistrements (chemin complet)."
msgstr "Recordings folder (full path)."

#: polyptyque-core/src/control/catalog.rs:289
msgid "Modèle de nom des fichiers, avec les variables {date}, {time}, {scene}, {source} (ou {heure}, {scène})."
msgstr "File name pattern, with the variables {date}, {time}, {scene}, {source} (or {heure}, {scène})."

#: polyptyque-core/src/control/catalog.rs:291
msgid "Aperçus en direct des sources dans la fenêtre."
msgstr "Live previews of the sources in the window."

#: polyptyque-core/src/control/catalog.rs:292
msgid "Conversion MP4 automatique à la fin de chaque enregistrement (le MKV est gardé)."
msgstr "Automatic MP4 conversion at the end of each recording (the MKV is kept)."

#: polyptyque-core/src/control/catalog.rs:293
msgid "Mises à jour proposées : stables, stables et bêta, ou aucune recherche."
msgstr "Updates offered: stable, stable and beta, or don’t check."

#: polyptyque-core/src/control/catalog.rs:294
msgid "Ouvrir les fenêtres de la scène au lancement de Polyptyque."
msgstr "Open the scene’s windows when Polyptyque starts."

#: polyptyque-core/src/control/catalog.rs:295
msgid "Fermer les navigateurs des sources en quittant Polyptyque."
msgstr "Close the sources’ browsers when quitting Polyptyque."

#: polyptyque-core/src/control/catalog.rs:299
msgid "Lancer Polyptyque au démarrage de Windows (en arrière-plan), pour que les programmations survivent à un redémarrage."
msgstr "Start Polyptyque when Windows starts (in the background), so scheduled recordings survive a restart."

#: polyptyque-core/src/control/catalog.rs:304
msgid "Fermeture de la fenêtre alors qu'une programmation est prévue : demander, continuer en arrière-plan, ou quitter."
msgstr "Closing the window while a scheduled recording is coming up: ask, keep running in the background, or quit."

#: polyptyque-core/src/control/catalog.rs:307
msgid "Langue de Polyptyque."
msgstr "Polyptyque’s language."

#: polyptyque-core/src/control/catalog.rs:308
msgid "Horloge des heures affichées et saisies."
msgstr "Clock used for displayed and entered times."

#: polyptyque-core/src/control/catalog.rs:309
msgid "Encodage vidéo, commun à toutes les sources."
msgstr "Video encoding, shared by all sources."

#: polyptyque-core/src/control/catalog.rs:310
msgid "Largeur en pixels (paire). 1920 pour du 1080p."
msgstr "Width in pixels (even). 1920 for 1080p."

#: polyptyque-core/src/control/catalog.rs:311
msgid "Hauteur en pixels (paire). 1080 pour du 1080p."
msgstr "Height in pixels (even). 1080 for 1080p."

#: polyptyque-core/src/control/catalog.rs:312
msgid "Images par seconde (1 à 240 ; 30 ou 60 en général)."
msgstr "Frame rate (1 to 240; usually 30 or 60)."

#: polyptyque-core/src/control/catalog.rs:313
msgid "Débit vidéo en kb/s (250 à 500 000). En 1080p à 60 i/s : 6 000 léger, 12 000 bon, 20 000 très bon."
msgstr "Video bitrate in kbps (250 to 500,000). At 1080p and 60 fps: 6,000 light, 12,000 good, 20,000 very good."

#: polyptyque-core/src/control/catalog.rs:314
msgid "Format vidéo : H.264 (compatibilité maximale au montage) ou HEVC (fichiers plus légers)."
msgstr "Video format: H.264 (best compatibility for editing) or HEVC (smaller files)."

#: polyptyque-core/src/control/catalog.rs:315
msgid "Matériel d'encodage : automatique (carte graphique si disponible), carte graphique, ou processeur."
msgstr "Encoding hardware: automatic (graphics card if available), graphics card, or CPU."

#: polyptyque-core/src/control/catalog.rs:317
msgid "Son des sources."
msgstr "Sources’ sound."

#: polyptyque-core/src/control/catalog.rs:320
msgid "Débit audio en kb/s (64 à 512 ; 192 par défaut)."
msgstr "Audio bitrate in kbps (64 to 512; 192 by default)."

#: polyptyque-core/src/control/catalog.rs:322
msgid "Micro, enregistré dans un fichier séparé."
msgstr "Mic, recorded to a separate file."

#: polyptyque-core/src/control/catalog.rs:326
msgid "Activer le micro : la personne doit l'accepter dans la fenêtre de Polyptyque (la commande attend sa réponse, deux minutes au plus)."
msgstr "Turn on the mic: the person must accept it in Polyptyque’s window (the command waits for their answer, two minutes at most)."

#: polyptyque-core/src/control/catalog.rs:328
msgid "Micro choisi (identifiant donné par microphones.list) ; vide pour le micro par défaut de Windows."
msgstr "Chosen mic (id from microphones.list); empty for the Windows default mic."

#: polyptyque-core/src/control/catalog.rs:330
msgid "Raccourcis clavier globaux, au format « Ctrl+Maj+F9 » ; vide pour aucun."
msgstr "Global keyboard shortcuts, written like “Ctrl+Shift+F9”; empty for none."

#: polyptyque-core/src/control/catalog.rs:331
msgid "Démarrer / arrêter tout."
msgstr "Start / stop all."

#: polyptyque-core/src/control/catalog.rs:332
msgid "Afficher / réduire Polyptyque."
msgstr "Show / minimize Polyptyque."

#: polyptyque-core/src/control/catalog.rs:333
msgid "Activer / couper les aperçus."
msgstr "Turn previews on / off."

#: polyptyque-core/src/control/catalog.rs:347
msgid "Présentation : version de Polyptyque et du protocole, langue. Le nom du programme client s'affiche dans Polyptyque tant qu'il est connecté."
msgstr "Introduction: Polyptyque and protocol versions, language. The client program’s name is shown in Polyptyque while it’s connected."

#: polyptyque-core/src/control/catalog.rs:348
msgid "Nom du programme client, affiché dans Polyptyque (« Claude », « Stream Deck »)."
msgstr "Name of the client program, shown in Polyptyque (“Claude”, “Stream Deck”)."

#: polyptyque-core/src/control/catalog.rs:353
msgid "État complet : enregistrement en cours, scène, sources et leurs fenêtres, disque, conversion, prochaine programmation, question en attente."
msgstr "Full status: recording in progress, scene, sources and their windows, disk, conversion, next scheduled recording, pending question."

#: polyptyque-core/src/control/catalog.rs:359
msgid "État en direct : Polyptyque envoie ensuite la notification « state » à chaque changement, et « message » pour chaque message qu'il affiche."
msgstr "Live status: Polyptyque then sends a “state” notification on every change, and “message” for every message it shows."

#: polyptyque-core/src/control/catalog.rs:362
msgid "Arrête l'état en direct."
msgstr "Stops the live status."

#: polyptyque-core/src/control/catalog.rs:366
msgid "Système : Windows, cartes graphiques, FFmpeg, dossiers, espace libre. Utile avant de choisir les réglages d'encodage."
msgstr "System: Windows, graphics cards, FFmpeg, folders, free space. Useful before choosing encoding settings."

#: polyptyque-core/src/control/catalog.rs:372
msgid "Essaie chaque encodeur (NVIDIA, AMD, Intel, processeur) en H.264 et en HEVC sur cette machine. Peut prendre une minute ; impossible pendant un enregistrement."
msgstr "Tries each encoder (NVIDIA, AMD, Intel, CPU) in H.264 and HEVC on this computer. Can take a minute; not possible during a recording."

#: polyptyque-core/src/control/catalog.rs:375
msgid "Affiche la fenêtre de Polyptyque au premier plan (depuis l'arrière-plan ou réduite)."
msgstr "Brings Polyptyque’s window to the front (from the background or minimized)."

#: polyptyque-core/src/control/catalog.rs:379
msgid "Active ou coupe les aperçus en direct des sources (sans effet sur les fichiers enregistrés)."
msgstr "Turns the sources’ live previews on or off (recorded files aren’t affected)."

#: polyptyque-core/src/control/catalog.rs:380
msgid "true pour activer, false pour couper."
msgstr "true to turn on, false to turn off."

#: polyptyque-core/src/control/catalog.rs:386
msgid "Scènes, dans leur ordre, avec leurs sources et la scène en cours. Une seule scène est en cours : c'est elle qui s'enregistre."
msgstr "Scenes, in order, with their sources and the current scene. Only one scene is current: that’s the one that records."

#: polyptyque-core/src/control/catalog.rs:392
msgid "Crée une scène vide."
msgstr "Creates an empty scene."

#: polyptyque-core/src/control/catalog.rs:394
msgid "Nom de la scène."
msgstr "Scene name."

#: polyptyque-core/src/control/catalog.rs:395
msgid "En faire la scène en cours (oui par défaut, comme dans la fenêtre)."
msgstr "Make it the current scene (yes by default, as in the window)."

#: polyptyque-core/src/control/catalog.rs:401
msgid "Renomme une scène."
msgstr "Renames a scene."

#: polyptyque-core/src/control/catalog.rs:402 polyptyque-core/src/control/catalog.rs:417 polyptyque-core/src/control/catalog.rs:423
msgid "Scène : son identifiant ou son nom."
msgstr "Scene: its id or its name."

#: polyptyque-core/src/control/catalog.rs:402
msgid "Nouveau nom."
msgstr "New name."

#: polyptyque-core/src/control/catalog.rs:407
msgid "Duplique une scène : la copie reprend les mêmes sources (partagées, pas copiées) et devient la scène en cours. Ses programmations ne sont pas reprises."
msgstr "Duplicates a scene: the copy uses the same sources (shared, not copied) and becomes the current scene. Its scheduled recordings aren’t copied."

#: polyptyque-core/src/control/catalog.rs:409
msgid "Scène à dupliquer (par défaut, la scène en cours)."
msgstr "Scene to duplicate (the current scene by default)."

#: polyptyque-core/src/control/catalog.rs:410
msgid "Nom de la copie (par défaut : « <nom> (copie) »)."
msgstr "Name of the copy (by default: “<name> (copy)”)."

#: polyptyque-core/src/control/catalog.rs:416
msgid "Supprime une scène, ses programmations, et les sources qui ne sont dans aucune autre scène (leurs profils de navigateur restent sur le disque). La dernière scène ne peut pas être supprimée."
msgstr "Deletes a scene, its scheduled recordings, and the sources that aren’t in any other scene (their browser profiles stay on disk). The last scene can’t be deleted."

#: polyptyque-core/src/control/catalog.rs:422
msgid "Change la scène en cours (impossible pendant un enregistrement)."
msgstr "Changes the current scene (not possible during a recording)."

#: polyptyque-core/src/control/catalog.rs:428
msgid "Ouvre les fenêtres manquantes de la scène en cours : navigateurs, et applications dont la relance est activée. Répond une fois les fenêtres apparues (30 secondes au plus)."
msgstr "Opens the current scene’s missing windows: browsers, and apps with “Relaunch” turned on. Answers once the windows have appeared (30 seconds at most)."

#: polyptyque-core/src/control/catalog.rs:435
msgid "Sources d'une scène, dans leur ordre, ou toutes les sources."
msgstr "A scene’s sources, in order, or all sources."

#: polyptyque-core/src/control/catalog.rs:437 polyptyque-core/src/control/catalog.rs:487 polyptyque-core/src/control/catalog.rs:496
msgid "Scène (par défaut, la scène en cours)."
msgstr "Scene (the current scene by default)."

#: polyptyque-core/src/control/catalog.rs:438
msgid "true : toutes les sources, avec les scènes de chacune."
msgstr "true: all sources, with the scenes each one is in."

#: polyptyque-core/src/control/catalog.rs:444
msgid "Navigateurs installés, utilisables pour une source navigateur."
msgstr "Installed browsers, usable for a browser source."

#: polyptyque-core/src/control/catalog.rs:450
msgid "Fenêtres ouvertes, pour ajouter une source application. Le titre d'une fenêtre n'est donné que si plusieurs fenêtres du même programme sont ouvertes."
msgstr "Open windows, for adding an app source. A window’s title is only given when several windows of the same program are open."

#: polyptyque-core/src/control/catalog.rs:456
msgid "Ajoute une source navigateur : un navigateur lancé avec un profil qui lui est propre (connexions et onglets conservés ; son isolé par profil, donc une source = ce qui doit être entendu). Pour Tor Browser, utiliser une source application."
msgstr "Adds a browser source: a browser started with its own profile (sign-ins and tabs are kept; sound is separated per profile, so one source = what should be heard). For Tor Browser, use an app source."

#: polyptyque-core/src/control/catalog.rs:458
msgid "Navigateur : son nom (donné par browsers.list) ou le chemin de son exécutable."
msgstr "Browser: its name (from browsers.list) or the path to its executable."

#: polyptyque-core/src/control/catalog.rs:459
msgid "Nom de la source, repris dans le nom des fichiers (par défaut : « Firefox 2 »…)."
msgstr "Source name, used in file names (by default: “Firefox 2”…)."

#: polyptyque-core/src/control/catalog.rs:460
msgid "Adresse ouverte au premier lancement du profil."
msgstr "Address opened the first time the profile starts."

#: polyptyque-core/src/control/catalog.rs:461
msgid "Ouvrir le navigateur tout de suite, pour s'y connecter (oui par défaut)."
msgstr "Open the browser right away, to sign in (yes by default)."

#: polyptyque-core/src/control/catalog.rs:462 polyptyque-core/src/control/catalog.rs:474
msgid "Scène où l'ajouter (par défaut, la scène en cours)."
msgstr "Scene to add it to (the current scene by default)."

#: polyptyque-core/src/control/catalog.rs:468
msgid "Ajoute une source application d'après une fenêtre ouverte (Discord, jeu, Tor Browser…)."
msgstr "Adds an app source from an open window (Discord, a game, Tor Browser…)."

#: polyptyque-core/src/control/catalog.rs:470
msgid "Fenêtre : son identifiant donné par windows.list."
msgstr "Window: its id from windows.list."

#: polyptyque-core/src/control/catalog.rs:471
msgid "Nom de la source (par défaut : le nom du programme)."
msgstr "Source name (by default: the program’s name)."

#: polyptyque-core/src/control/catalog.rs:472
msgid "Relancer le programme s'il n'est pas ouvert (non par défaut ; utile pour Discord, pas pour un jeu lancé par Steam)."
msgstr "Relaunch the program if it isn’t running (off by default; useful for Discord, not for a game started from Steam)."

#: polyptyque-core/src/control/catalog.rs:473
msgid "Afficher le curseur de la souris dans l'image (oui par défaut)."
msgstr "Show the mouse cursor in the picture (yes by default)."

#: polyptyque-core/src/control/catalog.rs:480
msgid "Ajoute une source existante à une autre scène : c'est la même source, partagée (même fenêtre, même profil), pas une copie. Jamais deux fois dans une scène."
msgstr "Adds an existing source to another scene: it’s the same source, shared (same window, same profile), not a copy. Never twice in one scene."

#: polyptyque-core/src/control/catalog.rs:481
msgid "Scène où l'ajouter."
msgstr "Scene to add it to."

#: polyptyque-core/src/control/catalog.rs:486
msgid "Retire une source d'une scène. Retirée de sa dernière scène, elle disparaît (son profil de navigateur reste sur le disque)."
msgstr "Removes a source from a scene. Removed from its last scene, it’s gone (its browser profile stays on disk)."

#: polyptyque-core/src/control/catalog.rs:492
msgid "Change la place d'une source dans sa scène (même ordre dans la liste et dans la grille des aperçus)."
msgstr "Changes a source’s position in its scene (same order in the list and in the preview grid)."

#: polyptyque-core/src/control/catalog.rs:495
msgid "Nouvelle place, 1 pour la première."
msgstr "New position, 1 for the first."

#: polyptyque-core/src/control/catalog.rs:502
msgid "Ouvre la fenêtre d'une source de la scène en cours (navigateur avec son profil, ou programme)."
msgstr "Opens the window of a source in the current scene (browser with its profile, or program)."

#: polyptyque-core/src/control/catalog.rs:508
msgid "Fait revenir la fenêtre réduite d'une source de la scène en cours (une fenêtre réduite donne une image figée)."
msgstr "Brings back the minimized window of a source in the current scene (a minimized window gives a frozen picture)."

#: polyptyque-core/src/control/catalog.rs:515
msgid "Démarre l'enregistrement de toutes les sources de la scène en cours, ou d'une seule (elle rejoint l'enregistrement en cours s'il y en a un). Un fichier par source. Répond une fois l'enregistrement démarré."
msgstr "Starts recording all sources of the current scene, or just one (it joins the recording in progress, if any). One file per source. Answers once the recording has started."

#: polyptyque-core/src/control/catalog.rs:517
msgid "Scène à enregistrer : elle devient la scène en cours (par défaut, la scène en cours)."
msgstr "Scene to record: it becomes the current scene (the current scene by default)."

#: polyptyque-core/src/control/catalog.rs:518
msgid "Une seule source de la scène : son identifiant ou son nom."
msgstr "A single source of the scene: its id or its name."

#: polyptyque-core/src/control/catalog.rs:519
msgid "Pendant un créneau programmé : arrêter automatiquement à la fin du créneau (non par défaut)."
msgstr "During a scheduled time slot: stop automatically when the time slot ends (off by default)."

#: polyptyque-core/src/control/catalog.rs:525
msgid "Arrête l'enregistrement (toutes les sources), ou une seule source. Répond une fois les fichiers finalisés, avec leur liste."
msgstr "Stops the recording (all sources), or a single source. Answers once the files are finalized, with their list."

#: polyptyque-core/src/control/catalog.rs:526
msgid "Une seule source : son identifiant ou son nom."
msgstr "A single source: its id or its name."

#: polyptyque-core/src/control/catalog.rs:531
msgid "Répond à la question affichée par une programmation (voir « prompt » dans status) : démarrage manqué, ou arrêt automatique d'un enregistrement lancé pendant un créneau."
msgstr "Answers the question shown by a scheduled recording (see “prompt” in status): missed start, or automatic stop of a recording started during a time slot."

#: polyptyque-core/src/control/catalog.rs:532
msgid "true : le bouton principal (enregistrer maintenant, arrêter à la fin du créneau) ; false : l'autre."
msgstr "true: the main button (record now, stop at the end of the time slot); false: the other one."

#: polyptyque-core/src/control/catalog.rs:538
msgid "Réglages, avec les valeurs proposées par la fenêtre des réglages (résolutions, cadences, raccourcis…)."
msgstr "Settings, with the values the Settings window offers (resolutions, frame rates, shortcuts…)."

#: polyptyque-core/src/control/catalog.rs:544
msgid "Modifie des réglages : seuls les champs donnés changent. Impossible pendant un enregistrement, ou pendant que la fenêtre des réglages est ouverte. Activer le micro demande l'accord de la personne dans Polyptyque."
msgstr "Changes settings: only the given fields change. Not possible during a recording, or while the Settings window is open. Turning on the mic needs the person’s approval in Polyptyque."

#: polyptyque-core/src/control/catalog.rs:550
msgid "Micros disponibles, pour le réglage microphone.device_id."
msgstr "Available mics, for the microphone.device_id setting."

#: polyptyque-core/src/control/catalog.rs:557
msgid "Programmations : chacune lance une scène d'une heure à une autre, une fois ou certains jours, avec son prochain créneau. Polyptyque doit être ouvert (au besoin en arrière-plan)."
msgstr "Scheduled recordings: each one records a scene from one time to another, once or on some days, with its next time slot. Polyptyque must be running (in the background if need be)."

#: polyptyque-core/src/control/catalog.rs:563
msgid "Crée une programmation. Une fin antérieure au début désigne le lendemain (22:00 → 02:00). Deux programmations activées ne peuvent pas se chevaucher."
msgstr "Creates a scheduled recording. An end before the start means the next day (22:00 → 02:00). Two scheduled recordings that are turned on can’t overlap."

#: polyptyque-core/src/control/catalog.rs:565 polyptyque-core/src/control/catalog.rs:579
msgid "Scène à enregistrer : son identifiant ou son nom."
msgstr "Scene to record: its id or its name."

#: polyptyque-core/src/control/catalog.rs:566 polyptyque-core/src/control/catalog.rs:580
msgid "Heure de début, « HH:MM » sur 24 h."
msgstr "Start time, “HH:MM”, 24-hour."

#: polyptyque-core/src/control/catalog.rs:567 polyptyque-core/src/control/catalog.rs:581
msgid "Heure de fin, « HH:MM » sur 24 h."
msgstr "End time, “HH:MM”, 24-hour."

#: polyptyque-core/src/control/catalog.rs:568
msgid "Une seule fois : date du début, « AAAA-MM-JJ ». Donner date ou days."
msgstr "Once: start date, “YYYY-MM-DD”. Give date or days."

#: polyptyque-core/src/control/catalog.rs:569
